---
import Layout from './Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import BlogViewToggle from '../components/ui/BlogViewToggle.astro';
import BlogPagination from '../components/ui/BlogPagination.astro';
import BlogPostCard from '../components/cards/BlogPostCard.astro';
import BlogArchiveCard from '../components/cards/BlogArchiveCard.astro';
import BlogSidebar from '../components/sections/BlogSidebar.astro';
import NewsletterSection from '../components/sections/NewsletterSection.astro';
import { getBlogPosts } from '../data/blog';
import { paginateBlogPosts, type BlogView } from '../data/blogPagination';

interface Props {
  view: BlogView;
  currentPage?: number;
}
const { view, currentPage = 1 } = Astro.props;
const allPosts = await getBlogPosts();
const { posts, totalPages } = paginateBlogPosts(allPosts, currentPage);
---

<Layout
  title={currentPage === 1 ? 'Blog - TIA Interior' : `Blog - Page ${currentPage} - TIA Interior`}
  description="Read the latest interior design tips, trends, and insights from TIA Interior."
>
  <PageHeader title="Blog" currentPage="Blog" />
  <section
    id="blog-posts"
    class:list={['blog-section fade-wrapper', view === 'grid' ? 'pt-150 pb-150' : 'pt-130 pb-130']}
  >
    <div class="container container-2">
      <BlogViewToggle view={view} currentPage={currentPage} />
      {
        view === 'grid' ? (
          <>
            <div class="row gy-5 fade-wrapper">
              {posts.map((post) => (
                <div class="col-lg-4 col-md-6 fade-top">
                  <BlogPostCard {...post} />
                </div>
              ))}
            </div>
            <BlogPagination view={view} currentPage={currentPage} totalPages={totalPages} />
          </>
        ) : (
          <div class="row gy-5">
            <div class="col-lg-8 col-md-12">
              {view === 'standard' ? (
                <div class="post-inner-card-wrap">
                  {posts.map((post) => (
                    <article class="post-card inner-post">
                      <BlogArchiveCard post={post} />
                    </article>
                  ))}
                </div>
              ) : (
                <div class="post-card-wrap post-card-wrap-inner blog-list-cards">
                  {posts.map((post) => (
                    <article class="post-card">
                      <BlogArchiveCard post={post} />
                    </article>
                  ))}
                </div>
              )}
              <BlogPagination view={view} currentPage={currentPage} totalPages={totalPages} />
            </div>
            <aside class="col-lg-4">
              <BlogSidebar posts={allPosts} />
            </aside>
          </div>
        )
      }
    </div>
  </section>
  {view === 'grid' && <NewsletterSection />}
</Layout>

<style>
  #blog-posts {
    scroll-margin-top: 100px;
  }
  /* Keep the template's horizontal cards within the eight-column content area. */
  .blog-list-cards {
    padding-left: 0;
  }
  .blog-list-cards .post-card {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }
  @media (max-width: 1199px) {
    .blog-list-cards .post-card {
      grid-template-columns: 1fr;
    }
  }
</style>
