---
import '../assets/scss/main.scss';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Sidebar from '../components/layout/Sidebar.astro';
import MobileMenu from '../components/layout/MobileMenu.astro';
import Preloader from '../components/layout/Preloader.astro';
import SearchBox from '../components/layout/SearchBox.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'TIA Interior - Architecture & Interior Design',
  description = 'TIA Interior transforms your vision into beautifully crafted spaces. Luxury interior design and architecture studio based in Dubai, UAE.',
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html class="no-js" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="shortcut icon" type="image/x-icon" href="/assets/img/favicon.png" />
    <link rel="stylesheet" href="/assets/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/assets/css/fontawesome.min.css" />
    <link rel="stylesheet" href="/assets/css/venobox.min.css" />
    <link rel="stylesheet" href="/assets/css/odometer.min.css" />
    <link rel="stylesheet" href="/assets/css/nice-select.css" />
    <link rel="stylesheet" href="/assets/css/carouselTicker.css" />
    <link rel="stylesheet" href="/assets/css/animation.css" />
    <link rel="stylesheet" href="/assets/css/twentytwenty.min.css" />
    <link rel="stylesheet" href="/assets/css/swiper.min.css" />
  </head>

  <body>
    <Preloader />
    <Header currentPath={currentPath} />
    <SearchBox />
    <Sidebar />
    <MobileMenu />

    <div id="antra-smooth-wrapper">
      <div id="antra-smooth-content">
        <slot />
        <Footer />
      </div>
    </div>

    <div id="scroll-percentage"><span id="scroll-percentage-value"></span></div>

    <script is:inline src="/assets/js/vendor/jquary-3.7.1.min.js"></script>
    <script is:inline src="/assets/js/vendor/bootstrap-bundle.js"></script>
    <script is:inline src="/assets/js/vendor/imagesloaded-pkgd.js"></script>
    <script is:inline src="/assets/js/vendor/waypoints.min.js"></script>
    <script is:inline src="/assets/js/vendor/venobox.min.js"></script>
    <script is:inline src="/assets/js/vendor/odometer.min.js"></script>
    <script is:inline src="/assets/js/vendor/meanmenu.js"></script>
    <script is:inline src="/assets/js/vendor/jquery.isotope.js"></script>
    <script is:inline src="/assets/js/vendor/swiper.min.js"></script>
    <script is:inline src="/assets/js/vendor/split-type.min.js"></script>
    <script is:inline src="/assets/js/vendor/gsap.min.js"></script>
    <script is:inline src="/assets/js/vendor/scroll-trigger.min.js"></script>
    <script is:inline src="/assets/js/vendor/scroll-smoother.js"></script>
    <script is:inline src="/assets/js/vendor/jquery.carouselTicker.js"></script>
    <script is:inline src="/assets/js/vendor/nice-select.js"></script>
    <script is:inline src="/assets/js/vendor/three.min.js"></script>
    <script is:inline src="/assets/js/vendor/panolens.min.js"></script>
    <script is:inline src="/assets/js/vendor/jquery.event.move.min.js"></script>
    <script is:inline src="/assets/js/vendor/jquery.twentytwenty.min.js"></script>
    <script is:inline src="/assets/js/slider.js"></script>
    <script is:inline src="/assets/js/banner-process.js"></script>
    <script is:inline src="/assets/js/contact.js"></script>
    <script is:inline src="/assets/js/main.js"></script>
  </body>
</html>
