---
/* eslint-disable astro/no-set-html-directive */
import homepageStylesheet from '../assets/scss/homepage.scss?url';
import fullStylesheet from '../assets/scss/main.scss?url';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Sidebar from '../components/layout/Sidebar.astro';
import MobileMenu from '../components/layout/MobileMenu.astro';
import SiteControls from '../components/ui/SiteControls.astro';
import SearchBox from '../components/layout/SearchBox.astro';
import LegacyScripts from '../components/seo/LegacyScripts.astro';
import StylesheetLinks from '../components/seo/StylesheetLinks.astro';
import { createPageJsonLd, createSiteJsonLd, resolvePageMeta, type OgType } from '../data/seo';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: OgType;
  canonical?: string;
  robots?: string;
  jsonLd?: unknown | unknown[];
}

const {
  title: titleProp,
  description: descriptionProp,
  ogImage: ogImageProp,
  ogType: ogTypeProp,
  canonical,
  robots: robotsProp,
  jsonLd: pageJsonLd = [],
} = Astro.props;

const currentPath = Astro.url.pathname;
const resolvedMeta = resolvePageMeta(currentPath, {
  title: titleProp,
  description: descriptionProp,
  ogImage: ogImageProp,
  ogType: ogTypeProp,
  robots: robotsProp,
});
const { title, description, ogImage, ogType, robots } = resolvedMeta;
const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).href;
const siteURL = Astro.site?.href ?? 'https://tiadecors.com/';
const ogImageURL = new URL(ogImage, siteURL).href;
const siteJsonLd = createSiteJsonLd(siteURL);
const routeJsonLd = createPageJsonLd(resolvedMeta, {
  path: currentPath,
  title,
  description,
  canonicalURL,
  ogImageURL,
});
const customJsonLd = Array.isArray(pageJsonLd) ? pageJsonLd : [pageJsonLd];

const jsonLd = [...siteJsonLd, ...routeJsonLd, ...customJsonLd.filter(Boolean)];
---

<!doctype html>
<html class="no-js" lang="en-AE">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" href={canonicalURL} hreflang="en-ae" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#101010" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={site.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />

    <link rel="preload" href="/assets/fonts/brand/cal-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/brand/golos-text-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/assets/css/brand-fonts.css" />

    <StylesheetLinks />
    <link rel="stylesheet" href={currentPath === '/' ? homepageStylesheet : fullStylesheet} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header currentPath={currentPath} />
    <SearchBox />
    <Sidebar />
    <MobileMenu />

    <div id="antra-smooth-wrapper">
      <div id="antra-smooth-content">
        <main id="main-content" tabindex="-1">
          <slot />
        </main>
        <Footer />
      </div>
    </div>

    <SiteControls />

    <LegacyScripts currentPath={currentPath} />
  </body>
</html>
