---
import type { HTMLAttributes } from 'astro/types';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{webp,png,jpg,jpeg,svg}', { eager: true });

interface Props extends HTMLAttributes<'img'> {
  src: string;
  alt: string;
  loading?: 'eager' | 'lazy';
  decoding?: 'async' | 'auto' | 'sync';
}

const { src, alt, loading = 'lazy', decoding = 'async', ...attrs } = Astro.props;
const image = images[src.replace('/assets/img/', '/src/assets/images/')]?.default;
const width = Number(attrs.width ?? image?.width);
const height = Number(attrs.height ?? (image ? Math.round(width * image.height / image.width) : undefined));
const widths = image ? [...new Set([320, 640, 960, 1280, 1920, width].filter(value => value > 0 && value <= image.width))].sort((a,b) => a-b) : [];
const decorative = attrs['aria-hidden'] === 'true' || ['shape', 'shapes', 'decoration'].includes(alt.toLowerCase());
---

{image ? <Image {...attrs} src={image} alt={decorative ? '' : alt} width={width} height={height} widths={widths} sizes={attrs.sizes ?? `(max-width: 767px) 100vw, ${width}px`} loading={loading} decoding={decoding} format="webp" /> : <img src={src} alt={decorative ? '' : alt} loading={loading} decoding={decoding} {...attrs} />}
