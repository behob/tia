---
interface Props {
  title: string;
  currentPage: string;
  parentLabel?: string;
  parentHref?: string;
}

const { title, currentPage, parentLabel = 'Home', parentHref = '/' } = Astro.props;

const siteUrl = Astro.site?.href || 'https://tiadecors.com';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: parentLabel,
      item: new URL(parentHref, siteUrl).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: currentPage,
      item: new URL(Astro.url.pathname, siteUrl).href,
    },
  ],
};
---

<section class="page-header">
  <div class="bg-img" data-background="/assets/img/bg-img/page-header-bg.png"></div>
  <div class="overlay"></div>
  <div class="container">
    <div class="page-header-content">
      <h1 class="title">{title}</h1>
      <h4 class="sub-title">
        <a class="home" href={parentHref}>{parentLabel}</a>
        <span class="icon">-</span>
        <a class="inner-page" href="#">{currentPage}</a>
      </h4>
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</section>
