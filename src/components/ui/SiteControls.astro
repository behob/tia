---
interface Props {}
---

<button type="button" id="scroll-percentage" aria-label="Scroll to top"
  ><span id="scroll-percentage-value" aria-hidden="true"></span></button
>
<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const panels = [
    { id: 'popup-search-box', selector: '.dl-search-icon', close: '.search-close', className: 'toggled' },
    {
      id: 'mobile-navigation',
      selector: '.mobile-side-menu-toggle',
      close: '.mobile-side-menu-close, .mobile-side-menu-overlay',
      className: 'is-open',
    },
    {
      id: 'sidebar-area',
      selector: '.sidebar-trigger.open',
      close: '.sidebar-trigger.close, #sidebar-overlay',
      className: 'open-sidebar',
    },
  ];
  let active: HTMLElement | null = null;
  let restore: HTMLElement | null = null;
  let closeActive = () => {};
  for (const config of panels) {
    const panel = document.getElementById(config.id);
    if (!panel) continue;
    panel.inert = true;
    panel.setAttribute('aria-hidden', 'true');
    const triggers = [...document.querySelectorAll<HTMLElement>(config.selector)];
    const target = config.id === 'sidebar-area' ? document.body : panel;
    const overlay = config.id === 'mobile-navigation' ? document.querySelector('.mobile-side-menu-overlay') : null;
    function close() {
      target.classList.remove(config.className);
      overlay?.classList.remove('is-open');
      panel!.inert = true;
      panel!.setAttribute('aria-hidden', 'true');
      triggers.forEach((trigger) => trigger.setAttribute('aria-expanded', 'false'));
      document.body.style.overflow = '';
      active = null;
      restore?.focus();
    }
    triggers.forEach((trigger) => {
      trigger.setAttribute('aria-controls', config.id);
      trigger.setAttribute('aria-expanded', 'false');
      trigger.addEventListener('click', () => {
        if (active) closeActive();
        restore = trigger;
        active = panel;
        closeActive = close;
        panel.inert = false;
        panel.setAttribute('aria-hidden', 'false');
        target.classList.add(config.className);
        overlay?.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
        panel.querySelector<HTMLElement>('input, button, a[href]')?.focus();
      });
    });
    document.querySelectorAll(config.close).forEach((button) => button.addEventListener('click', close));
    panel.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        close();
      }
      if (event.key === 'Tab') {
        const items = [...panel.querySelectorAll<HTMLElement>('a[href],button,input,summary,[tabindex="0"]')].filter(
          (el) => el.getClientRects().length && !el.hasAttribute('disabled'),
        );
        const first = items[0],
          last = items.at(-1);
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last?.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first?.focus();
        }
      }
    });
  }
  const back = document.getElementById('scroll-percentage')!;
  function updateScroll() {
    const top = document.documentElement.scrollTop;
    const height = document.documentElement.scrollHeight - innerHeight;
    const progress = height > 0 ? Math.min(100, Math.round((top / height) * 100)) : 0;
    back.classList.toggle('active', top > 100);
    back.querySelector('span')!.textContent = progress < 96 ? `${progress}%` : '↑';
    back.style.background = `conic-gradient(var(--tl-color-common-white) ${progress}%, var(--tl-color-theme-primary) ${progress}%)`;
    document.querySelector('.primary-header')?.classList.toggle('fixed', top >= 110);
  }
  addEventListener('scroll', updateScroll, { passive: true });
  updateScroll();
  back.addEventListener('click', () => {
    scrollTo({ top: 0, behavior: reduced.matches ? 'instant' : 'smooth' });
  });
  document.querySelectorAll<HTMLElement>('[data-background]').forEach((el) => {
    const src = innerWidth <= 767 && el.dataset.backgroundMobile ? el.dataset.backgroundMobile : el.dataset.background;
    if (src) el.style.backgroundImage = `url("${src}")`;
  });
</script>
<style is:global>
  [data-background] {
    background-image: var(--bg-desktop);
  }
  @media (max-width: 767px) {
    [data-background] {
      background-image: var(--bg-mobile);
    }
  }
  .skip-link {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 10000;
    padding: 12px 20px;
    background: #fff;
    color: #111;
    clip-path: inset(50%);
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .skip-link:focus {
    clip-path: none;
    width: auto;
    height: auto;
    overflow: visible;
  }
  :focus-visible {
    outline: 3px solid #ca9b65 !important;
    outline-offset: 4px;
  }
  #scroll-percentage {
    border: 0;
  }
  .header .header-menu-wrap ul li:focus-within > ul {
    visibility: visible;
    opacity: 1;
    top: 100%;
  }
  .native-mobile-toggle {
    display: none;
    background: none;
    color: inherit;
    border: 0;
    font-size: 26px;
  }
  @media (max-width: 991px) {
    .native-mobile-toggle {
      display: block;
      width: 44px;
      height: 44px;
      color: #fff;
    }
    .header .primary-header-inner .header-right-wrap .search-icon {
      display: flex !important;
      width: 44px;
      height: 44px;
    }
    .header .sidebar-icon {
      display: none;
    }
  }
  .mobile-navigation-links {
    display: grid;
    gap: 15px;
    padding: 20px 0;
  }
  .mobile-navigation-links details a {
    display: block;
    padding: 8px 16px;
  }
  .mobile-navigation-links summary {
    cursor: pointer;
  }
  [data-animation] {
    opacity: 1;
  }
  .slider-section:not(.slider-ready) .swiper-slide:not(:first-child) {
    visibility: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
