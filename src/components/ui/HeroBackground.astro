---
import OptimizedImage from './OptimizedImage.astro';
interface Props {
  src: string;
  priority?: boolean;
}
const { src, priority = false } = Astro.props;
---

<div class="bg-img hero-background">
  <OptimizedImage
    src={src}
    alt=""
    width={1920}
    height={1080}
    sizes="100vw"
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'low'}
  />
</div>
<style>
  .hero-background :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero-background::before {
    z-index: 1 !important;
    pointer-events: none;
  }
</style>
