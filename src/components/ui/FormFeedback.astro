---
interface Props {}
---

<p class="form-feedback mt-10" role="status" aria-live="polite" aria-atomic="true"></p>
<p class="security-feedback" aria-live="polite"></p>
<noscript
  ><p>
    The security check requires JavaScript. You can also <a href="mailto:info@tiadecors.com">email info@tiadecors.com</a
    >.
  </p></noscript
>
<script>
  type TurnstileOptions = {
    sitekey: string;
    callback: (token: string) => void;
    'expired-callback': () => void;
    'error-callback': () => void;
  };
  type Turnstile = {
    reset: (id?: string) => void;
    render: (el: HTMLElement, options: TurnstileOptions) => string;
  };
  const host = window as Window & { turnstile?: Turnstile };
  let loader: Promise<void> | undefined;
  function loadTurnstile() {
    return (loader ??= new Promise((resolve, reject) => {
      if (host.turnstile) return resolve();
      const script = document.createElement('script');
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      script.async = true;
      script.onload = () => resolve();
      script.onerror = () => {
        loader = undefined;
        reject();
      };
      document.head.appendChild(script);
    }));
  }
  document.querySelectorAll<HTMLFormElement>('form[data-enhanced-form]').forEach((form) => {
    const feedback = form.querySelector<HTMLElement>('[role="status"]')!;
    const securityFeedback = form.querySelector<HTMLElement>('.security-feedback')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const challenge = form.querySelector<HTMLElement>('[data-turnstile-key]');
    let widget: string | undefined;
    let initializing = false;
    let securityToken = '';
    const waitForSecurity = (message: string) => {
      securityToken = '';
      submit.disabled = true;
      securityFeedback.textContent = message;
    };
    const acceptSecurityToken = (token: string) => {
      if (!token) return waitForSecurity('Please complete the security check.');
      securityToken = token;
      submit.disabled = false;
      securityFeedback.textContent = '';
    };
    waitForSecurity('Loading security check…');
    async function initialize() {
      if (initializing || widget) return;
      if (!challenge?.dataset.turnstileKey) {
        waitForSecurity('The security check is unavailable. Please try again or email info@tiadecors.com.');
        return;
      }
      initializing = true;
      try {
        await loadTurnstile();
        widget = host.turnstile!.render(challenge, {
          sitekey: challenge.dataset.turnstileKey,
          callback: acceptSecurityToken,
          'expired-callback': () => waitForSecurity('The security check expired. Please complete it again.'),
          'error-callback': () =>
            waitForSecurity('The security check could not load. Please try again or email info@tiadecors.com.'),
        });
      } catch {
        initializing = false;
        waitForSecurity('The security check could not load. Please try again or email info@tiadecors.com.');
      }
    }
    form.addEventListener('focusin', initialize);
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          void initialize();
          observer.disconnect();
        }
      },
      { rootMargin: '200px' },
    );
    observer.observe(form);
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const token = securityToken;
      if (!token) {
        waitForSecurity('Please wait for the security check to complete.');
        void initialize();
        return;
      }
      submit.disabled = true;
      form.setAttribute('aria-busy', 'true');
      feedback.textContent = 'Sending…';
      try {
        const body = new URLSearchParams();
        new FormData(form).forEach((value, key) => {
          if (typeof value === 'string') body.set(key, value);
        });
        body.set('cf-turnstile-response', token);
        const response = await fetch(form.action, { method: 'POST', body, signal: AbortSignal.timeout(30000) });
        feedback.textContent = await response.text();
        feedback.classList.toggle('error', !response.ok);
        feedback.classList.toggle('success', response.ok);
        if (response.ok) form.reset();
      } catch {
        feedback.textContent = 'The request could not be completed. Please try again or email info@tiadecors.com.';
      } finally {
        if (widget) {
          waitForSecurity('Refreshing security check…');
          host.turnstile?.reset(widget);
        } else {
          submit.disabled = false;
        }
        form.removeAttribute('aria-busy');
      }
    });
  });
</script>
<style>
  .security-feedback:not(:empty) {
    margin-top: 10px;
  }
</style>
