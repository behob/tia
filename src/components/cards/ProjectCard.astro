---
import OptimizedImage from '../ui/OptimizedImage.astro';
import { getPortfolioHref } from '../../data/detailPages';

interface Props {
  image: string;
  title: string;
  href?: string;
  category?: string;
  year?: string;
}

const { image, title, href, category = 'Residential', year = '2025' } = Astro.props;
const resolvedHref = href ?? getPortfolioHref(title, category);
---

<div class="project-item antra-hover-view">
  <div class="project-img">
    <a class="d-block p-relative z-1" href={resolvedHref}>
      <OptimizedImage src={image} alt={title} />
    </a>
    <ul>
      <li><a href={resolvedHref}>{category}</a></li>
      <li><a href={resolvedHref}>{title}</a></li>
    </ul>
  </div>
  <div class="project-content">
    <h3 class="title"><a href={resolvedHref}>{title}</a></h3>
    <span>Dubai, UAE<br />{year}</span>
  </div>
</div>
