---
import OptimizedImage from '../ui/OptimizedImage.astro';
import { getBlogHref } from '../../data/detailPages';

interface Props {
  image: string;
  title: string;
  excerpt: string;
  date: string;
  author?: string;
  category?: string;
  href?: string;
  variant?: 'default' | 'inner';
}

const {
  image,
  title,
  excerpt,
  date,
  author = 'Admin',
  category = 'Design',
  href,
  variant = 'default',
} = Astro.props;

const resolvedHref = href ?? getBlogHref(title);
---

<div class={`post-card ${variant === 'inner' ? 'post-card-2 inner-post' : ''}`}>
  {
    variant === 'default' && (
      <div class="post-thumb">
        <OptimizedImage src={image} alt={title} />
        <span class="category">{category}</span>
      </div>
    )
  }
  <div class="post-content">
    <ul class="post-meta">
      {variant === 'inner' && <li class="category">{category}</li>}
      <li>{date}</li>
      <li>By <span>{author}</span></li>
    </ul>
    <h3 class="title"><a href={resolvedHref}>{title}</a></h3>
    {variant === 'default' && <p>{excerpt}</p>}
  </div>
</div>
