---
interface Props {
  icon: string;
  title: string;
  description?: string;
  desc?: string;
  href?: string;
}

const { icon, title, description, desc, href = '/service-details' } = Astro.props;
const cardDescription = description || desc || '';
---

<div class="service-item slide-anim" data-delay="0.3" data-offset="100" data-direction="bottom">
  <div class="service-top">
    <h3 class="title"><a href={href}>{title}</a></h3>
    <div class="icon">
      <img src={icon} alt={title} loading="lazy" />
    </div>
  </div>
  <p>{cardDescription}</p>
</div>
