---
import OptimizedImage from '../ui/OptimizedImage.astro';
import { getTeamHref } from '../../data/detailPages';

interface Props {
  image: string;
  name: string;
  role: string;
  href?: string;
  variant?: 'list' | 'grid';
  social?: {
    facebook?: string;
    instagram?: string;
    behance?: string;
    linkedin?: string;
  };
}

const { image, name, role, href, variant = 'grid', social = {} } = Astro.props;
const resolvedHref = href ?? getTeamHref(name);
---

{
  variant === 'grid' ? (
    <div class="team-item-2">
      <div class="team-thumb">
        <OptimizedImage src={image} alt={name} />
      </div>
      <div class="team-content">
        <h3 class="title">
          <a href={resolvedHref}>{name}</a>
        </h3>
        <span>{role}</span>
        <ul class="team-social">
          {social.facebook && (
            <li>
              <a href={social.facebook}>
                <i class="fa-brands fa-facebook-f" />
              </a>
            </li>
          )}
          {social.instagram && (
            <li>
              <a href={social.instagram}>
                <i class="fa-brands fa-instagram" />
              </a>
            </li>
          )}
          {social.behance && (
            <li>
              <a href={social.behance}>
                <i class="fa-brands fa-behance" />
              </a>
            </li>
          )}
          {social.linkedin && (
            <li>
              <a href={social.linkedin}>
                <i class="fa-brands fa-linkedin-in" />
              </a>
            </li>
          )}
        </ul>
      </div>
    </div>
  ) : (
    <div class="team-item" data-img={image}>
      <div class="left-content">
        <span class="number">
          <slot name="number" />
        </span>
        <h3 class="title">
          <a href={resolvedHref}>{name}</a>
        </h3>
      </div>
      <div class="mid-content">
        <span>{role}</span>
      </div>
      <div class="arrow">
        <a href={resolvedHref}>
          <i class="fa-solid fa-arrow-right" />
        </a>
      </div>
    </div>
  )
}
