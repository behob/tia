<div id="popup-search-box" role="dialog" aria-modal="true" aria-label="Search the website">
  <div class="box-inner-wrap d-flex align-items-center">
    <form id="form" action="/search" method="get" role="search">
      <input id="popup-search" type="text" name="q" placeholder="Type keywords here..." aria-label="Search" />
      <button type="submit" class="search-submit">Search</button>
    </form>
    <button type="button" class="search-close" aria-label="Close search"
      ><i class="fa-sharp fa-regular fa-xmark"></i></button
    >
  </div>
</div>

<style>
  .search-submit {
    position: absolute;
    right: 25px;
    top: 15px;
    padding: 5px;
    background: transparent;
    border: 0;
    color: #333;
  }
</style>
