---
import OptimizedImage from '../ui/OptimizedImage.astro';
import { site } from '../../data/site';
---

<div id="mobile-navigation" class="mobile-side-menu" role="dialog" aria-modal="true" aria-label="Navigation">
  <div class="side-menu-content">
    <div class="side-menu-head">
      <a href="/"
        ><OptimizedImage
          src="/assets/img/logo/logo-2.webp"
          alt={`${site.name} logo`}
          width="124"
          height="29"
          loading="lazy"
        /></a
      >
      <button class="mobile-side-menu-close" aria-label="Close navigation menu"
        ><i class="fa-regular fa-xmark"></i></button
      >
    </div>
    <nav class="mobile-navigation-links" aria-label="Mobile navigation">
      <a href="/">Home</a>
      <details><summary>Spaces</summary>{site.nav.home.map((item) => <a href={item.href}>{item.label}</a>)}</details>
      <details>
        <summary>Services</summary>{site.nav.services.map((item) => <a href={item.href}>{item.label}</a>)}
      </details>
      <details>
        <summary>Portfolio</summary>{site.nav.portfolio.map((item) => <a href={item.href}>{item.label}</a>)}
      </details>
      <details><summary>Studio</summary>{site.nav.pages.map((item) => <a href={item.href}>{item.label}</a>)}</details>
      <a href="/blog-grid">Blog</a><a href="/contact">Contact</a>
    </nav>
    <div class="side-menu-contact">
      <div class="side-menu-header">
        <h3>Contact Us</h3>
      </div>
      <ul class="side-menu-list">
        <li>
          <i class="fas fa-map-marker-alt"></i>
          <p>{site.address}</p>
        </li>
        <li>
          <i class="fas fa-phone"></i>
          <a href={`tel:${site.phoneRaw}`}>{site.phone}</a>
        </li>
        <li>
          <i class="fas fa-envelope-open-text"></i>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
      </ul>
    </div>
    <ul class="side-menu-social">
      {
        site.socials.slice(0, 4).map((social) => (
          <li class={social.platform}>
            <a href={social.href} aria-label={social.label}>
              <i class={social.icon} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
<div class="mobile-side-menu-overlay"></div>

<noscript
  ><nav aria-label="Navigation without JavaScript">
    <a href="/">Home</a> · <a href="/service">Services</a> · <a href="/portfolio">Portfolio</a> · <a href="/blog-grid"
      >Blog</a
    > · <a href="/contact">Contact</a>
  </nav></noscript
>
