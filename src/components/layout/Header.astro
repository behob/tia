---
import { site } from '../../data/site';

const { nav } = site;
---

<header class="header sticky-active">
  <div class="primary-header">
    <div class="container">
      <div class="primary-header-inner">
        <div class="header-left-wrap">
          <div class="header-logo d-lg-block">
            <a href="/">
              <img src="/assets/img/logo/logo-2.webp" alt={`${site.name} logo`} width="124" height="29" />
            </a>
          </div>
          <div class="header-menu-wrap">
            <div class="mobile-menu-items">
              <ul>
                <li class="menu-item-has-children">
                  <a href="#">Home</a>
                  <ul>
                    {
                      nav.home.map((item) => (
                        <li>
                          <a href={item.href}>{item.label}</a>
                        </li>
                      ))
                    }
                  </ul>
                </li>
                <li class="menu-item-has-children">
                  <a href="/service">Services</a>
                  <ul>
                    {
                      nav.services.map((item) => (
                        <li>
                          <a href={item.href}>{item.label}</a>
                        </li>
                      ))
                    }
                  </ul>
                </li>
                <li class="menu-item-has-children">
                  <a href="/portfolio">Portfolio</a>
                  <ul>
                    {
                      nav.portfolio.map((item) => (
                        <li>
                          <a href={item.href}>{item.label}</a>
                        </li>
                      ))
                    }
                  </ul>
                </li>
                <li class="menu-item-has-children">
                  <a href="#">Pages</a>
                  <ul>
                    {
                      nav.pages.map((item) => (
                        <li>
                          <a href={item.href}>{item.label}</a>
                        </li>
                      ))
                    }
                  </ul>
                </li>
                <li class="menu-item-has-children">
                  <a href="/blog-grid">Blog</a>
                  <ul>
                    {
                      nav.blog.map((item) => (
                        <li>
                          <a href={item.href}>{item.label}</a>
                        </li>
                      ))
                    }
                  </ul>
                </li>
                <li><a href="/contact">Contact</a></li>
              </ul>
            </div>
          </div>
        </div>
        <div class="header-right-wrap">
          <a href={`tel:${site.phoneRaw}`} class="header-contact">
            <span class="icon"><i class="fa-regular fa-phone"></i></span>
            <span class="content">
              <span class="call-text">Call Us Phone</span>
              <span class="call-number">({site.phone})</span>
            </span>
          </a>
          <div class="header-btn-wrap">
            <a href="/contact" class="tl-primary-btn header-btn">Get in Touch</a>
          </div>
          <button type="button" class="search-icon dl-search-icon" aria-label="Open search dialog">
            <i class="fa-solid fa-magnifying-glass"></i>
          </button>
          <div class="sidebar-icon">
            <button class="sidebar-trigger open" aria-label="Open sidebar menu">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path
                  d="M11 2C11 0.89543 11.8954 0 13 0H14C15.1046 0 16 0.895431 16 2V3C16 4.10457 15.1046 5 14 5H13C11.8954 5 11 4.10457 11 3V2Z"
                  fill="white"></path>
                <path
                  d="M0 2C0 0.89543 0.895431 0 2 0H3C4.10457 0 5 0.895431 5 2V3C5 4.10457 4.10457 5 3 5H2C0.895431 5 0 4.10457 0 3V2Z"
                  fill="white"></path>
                <path
                  d="M0 13C0 11.8954 0.895431 11 2 11H3C4.10457 11 5 11.8954 5 13V14C5 15.1046 4.10457 16 3 16H2C0.895431 16 0 15.1046 0 14V13Z"
                  fill="white"></path>
                <path
                  d="M11 13C11 11.8954 11.8954 11 13 11H14C15.1046 11 16 11.8954 16 13V14C16 15.1046 15.1046 16 14 16H13C11.8954 16 11 15.1046 11 14V13Z"
                  fill="white"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
