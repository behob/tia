---
import { site } from '../../data/site';
---

<div id="sidebar-area" class="sidebar-area">
  <button class="sidebar-trigger close">
    <svg
      class="sidebar-close"
      xmlns="http://www.w3.org/2000/svg"
      xmlns:xlink="http://www.w3.org/1999/xlink"
      x="0px"
      y="0px"
      width="16px"
      height="12.7px"
      viewBox="0 0 16 12.7"
      style="enable-background: new 0 0 16 12.7"
      xml:space="preserve"
    >
      <g>
        <rect x="0" y="5.4" transform="matrix(0.7071 -0.7071 0.7071 0.7071 -2.1569 7.5208)" width="16" height="2"
        ></rect>
        <rect x="0" y="5.4" transform="matrix(0.7071 0.7071 -0.7071 0.7071 6.8431 -3.7929)" width="16" height="2"
        ></rect>
      </g>
    </svg>
  </button>
  <div class="side-menu-content">
    <div class="side-menu-logo">
      <a class="dark-img" href="/"><img src="/assets/img/logo/logo-2.png" alt={`${site.name} logo`} loading="lazy" /></a
      >
      <a class="light-img" href="/"
        ><img src="/assets/img/logo/logo-1.png" alt={`${site.name} logo`} loading="lazy" /></a
      >
    </div>
    <div class="side-menu-wrap"></div>
    <div class="side-menu-about">
      <h4 class="title">We Shape Interior Designs, Crafting Timeless and Inspiring Spaces</h4>
    </div>
    <div class="side-menu-gallary">
      <div class="side-menu-gallary-item">
        <a href="/assets/img/project/sidebar-gallary-1.png" class="venobox" data-gall="gallary1"
          ><img src="/assets/img/project/sidebar-gallary-1.png" alt="gallery" loading="lazy" /></a
        >
      </div>
      <div class="side-menu-gallary-item">
        <a href="/assets/img/project/sidebar-gallary-2.png" class="venobox" data-gall="gallary1"
          ><img src="/assets/img/project/sidebar-gallary-2.png" alt="gallery" loading="lazy" /></a
        >
      </div>
      <div class="side-menu-gallary-item">
        <a href="/assets/img/project/sidebar-gallary-3.png" class="venobox" data-gall="gallary1"
          ><img src="/assets/img/project/sidebar-gallary-3.png" alt="gallery" loading="lazy" /></a
        >
      </div>
      <div class="side-menu-gallary-item">
        <a href="/assets/img/project/sidebar-gallary-4.png" class="venobox" data-gall="gallary1"
          ><img src="/assets/img/project/sidebar-gallary-4.png" alt="gallery" loading="lazy" /></a
        >
      </div>
      <div class="side-menu-gallary-item">
        <a href="/assets/img/project/sidebar-gallary-5.png" class="venobox" data-gall="gallary1"
          ><img src="/assets/img/project/sidebar-gallary-5.png" alt="gallery" loading="lazy" /></a
        >
      </div>
      <div class="side-menu-gallary-item">
        <a href="/assets/img/project/sidebar-gallary-6.png" class="venobox" data-gall="gallary1"
          ><img src="/assets/img/project/sidebar-gallary-6.png" alt="gallery" loading="lazy" /></a
        >
      </div>
    </div>
    <div class="side-menu-contact">
      <ul class="side-menu-list">
        <li>
          SkyCourts<br />Wadi Al Safa 5, Dubai,<br /> UAE
        </li>
        <li>
          <a href={`tel:${site.phoneRaw}`}>({site.phone})</a>
        </li>
        <li>
          <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
        </li>
      </ul>
    </div>
    <ul class="side-menu-social">
      {
        site.socials.slice(0, 4).map((social) => (
          <li class={social.platform}>
            <a href={social.href}>
              <i class={social.icon} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
<div id="sidebar-overlay"></div>
