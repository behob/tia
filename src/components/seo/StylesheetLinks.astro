---
import { stylesheetAssets } from '../../data/assets';
const simple = /^\/(?:blog(?:-|\/)|contact(?:\/|$)|search(?:\/|$)|404(?:\/|$))/.test(Astro.url.pathname);
const styles = (
  simple ? stylesheetAssets.filter((asset) => /bootstrap|fontawesome/.test(asset.href)) : stylesheetAssets
).map((asset) =>
  Astro.url.pathname === '/' && asset.href === '/assets/css/swiper.min.css'
    ? { ...asset, preload: false, deferred: true }
    : asset,
);
---

{
  styles.map((asset) => (
    <>
      {asset.preload && <link rel="preload" href={asset.href} as="style" />}
      {asset.deferred ? (
        <>
          <link rel="stylesheet" href={asset.href} media="print" onload="this.removeAttribute('media')" />
          <noscript>
            <link rel="stylesheet" href={asset.href} />
          </noscript>
        </>
      ) : (
        <link rel="stylesheet" href={asset.href} />
      )}
    </>
  ))
}
