---
import HeroBackground from '../../ui/HeroBackground.astro';
import OptimizedImage from '../../ui/OptimizedImage.astro';
interface Props {}
---

<section class="slider-section overflow-hidden">
  <div class="antra-slider slider-2 slider-9 swiper-container">
    <div class="swiper-wrapper">
      <div class="swiper-slide">
        <div class="slider-item">
          <HeroBackground src="/assets/img/bg-img/slider-img-2.webp" priority={true} />
          <div class="slider-text"><span>Interior</span></div>
          <div class="container slider-container">
            <div class="slider-content-wrap">
              <div class="slider-content">
                <div class="section-heading white-content text-center align-items-center">
                  <h4 class="sub-heading">Trusted Design Partner</h4>
                  <h1 class="section-title cursor-effect">
                    Find Your <span>Inspired <br /> Interior Design</span>
                  </h1>
                  <div class="slider-btn mt-50">
                    <a href="/contact">Start <br /> Project</a>
                  </div>
                </div>
                <div class="bottom-content">
                  <div class="antra-desc">
                    <p>
                      Transform your vision into reality with our innovative designs, creating modern spaces that blend
                      functionality, aesthetics, and sustainability.
                    </p>
                  </div>
                  <div class="slider-video-area">
                    <span>Watch a Video <br />About Us</span>
                    <div class="play-btn-wrap">
                      <OptimizedImage src="/assets/img/images/slider-play-img.webp" alt="img" loading="eager" />
                      <div class="play-btn">
                        <a
                          class="video-popup venobox"
                          data-autoplay="true"
                          data-vbtype="video"
                          href="https://youtu.be/JwC-Qx1lJso"
                        >
                          <i class="fa-solid fa-play"></i>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="swiper-slide">
        <div class="slider-item">
          <HeroBackground src="/assets/img/bg-img/slider-img-1.webp" priority={false} />
          <div class="slider-text"><span>Interior</span></div>
          <div class="container slider-container">
            <div class="slider-content-wrap">
              <div class="slider-content">
                <div class="section-heading white-content text-center align-items-center">
                  <h4 class="sub-heading">Trusted Design Partner</h4>
                  <h2 class="section-title cursor-effect">
                    Find Your <span>Inspired <br /> Interior Design</span>
                  </h2>
                  <div class="slider-btn mt-50">
                    <a href="/contact">Start <br /> Project</a>
                  </div>
                </div>
                <div class="bottom-content">
                  <div class="antra-desc">
                    <p>
                      Transform your vision into reality with our innovative designs, creating modern spaces that blend
                      functionality, aesthetics, and sustainability.
                    </p>
                  </div>
                  <div class="slider-video-area">
                    <span>Watch a Video <br />About Us</span>
                    <div class="play-btn-wrap">
                      <OptimizedImage src="/assets/img/images/slider-play-img.webp" alt="img" loading="eager" />
                      <div class="play-btn">
                        <a
                          class="video-popup venobox"
                          data-autoplay="true"
                          data-vbtype="video"
                          href="https://youtu.be/JwC-Qx1lJso"
                        >
                          <i class="fa-solid fa-play"></i>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
