---
import OptimizedImage from '../../ui/OptimizedImage.astro';
interface Props {}
---

<section class="exp-section pt-130 pb-130 fade-wrapper">
  <div class="container container-2">
    <div class="section-heading white-content exp-heading fade-top">
      <h4
        class="sub-heading"
        data-text-animation="fade-in-right"
        data-split="char"
        data-duration="0.9"
        data-stagger="0.03"
      >
        Our expertise
      </h4>
      <h2 class="section-title cursor-effect">
        Curating the perfect <span>pieces <br />to complete</span> your space
      </h2>
    </div>
    <div class="row exp-wrap fade-wrapper">
      <div class="col-lg-3 col-md-6 fade-top">
        <div class="exp-item">
          <div class="exp-img">
            <OptimizedImage src="/assets/img/images/exp-img-1.webp" alt="exp" loading="lazy" />
          </div>
          <div class="exp-content">
            <h3 class="title">Renovation and <br />remodeling</h3>
            <span class="line"></span>
            <p>Eget odio non ac mi. Porttitor diam viverra est suspendisse. Fermentum est interdum.</p>
          </div>
        </div>
      </div>
      <div class="col-lg-3 col-md-6 fade-top">
        <div class="exp-item">
          <div class="exp-img">
            <OptimizedImage src="/assets/img/images/exp-img-2.webp" alt="exp" loading="lazy" />
          </div>
          <div class="exp-content">
            <h3 class="title">Custom design <br />consultation</h3>
            <span class="line"></span>
            <p>Eget odio non ac mi. Porttitor diam viverra est suspendisse. Fermentum est interdum.</p>
          </div>
        </div>
      </div>
      <div class="col-lg-3 col-md-6 fade-top">
        <div class="exp-item">
          <div class="exp-img">
            <OptimizedImage src="/assets/img/images/exp-img-3.webp" alt="exp" loading="lazy" />
          </div>
          <div class="exp-content">
            <h3 class="title">Space planning <br />and layout</h3>
            <span class="line"></span>
            <p>Eget odio non ac mi. Porttitor diam viverra est suspendisse. Fermentum est interdum.</p>
          </div>
        </div>
      </div>
      <div class="col-lg-3 col-md-6 fade-top">
        <div class="exp-item">
          <div class="exp-img">
            <OptimizedImage src="/assets/img/images/exp-img-4.webp" alt="exp" loading="lazy" />
          </div>
          <div class="exp-content">
            <h3 class="title">3D design <br />visualization</h3>
            <span class="line"></span>
            <p>Eget odio non ac mi. Porttitor diam viverra est suspendisse. Fermentum est interdum.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
