---
import OptimizedImage from '../../ui/OptimizedImage.astro';
interface Props {}
---

<section class="project-section-2 bg-grey pt-130 overflow-hidden">
  <div class="project-text"><span>interior design</span></div>
  <div class="shape-1"><OptimizedImage src="/assets/img/shapes/project-shape-2.webp" alt="shape" loading="lazy" /></div>
  <div class="container container-2">
    <div class="section-heading text-center align-items-center">
      <h4
        class="sub-heading"
        data-text-animation="fade-in-right"
        data-split="char"
        data-duration="0.9"
        data-stagger="0.03"
      >
        Our Projects
      </h4>
      <h2 class="section-title cursor-effect title-2">Creative <span>projects that <br /> define</span> our style</h2>
    </div>
    <div class="project-item-wrap-2">
      <div class="project-item-2 antra-hover-view">
        <div class="project-thumb">
          <a href="/portfolio-details"
            ><OptimizedImage src="/assets/img/project/project-1.webp" alt="project" loading="lazy" /></a
          >
          <ul>
            <li>Residential</li>
            <li>Single Home</li>
          </ul>
        </div>
        <div class="project-content">
          <h3 class="title">Coastal Harmony <br /> Home</h3>
          <p>Berlin, Germany <br /> 2025</p>
        </div>
      </div>
      <div class="project-item-2 antra-hover-view">
        <div class="project-thumb">
          <a href="/portfolio-details"
            ><OptimizedImage src="/assets/img/project/project-2.webp" alt="project" loading="lazy" /></a
          >
          <ul>
            <li>Residential</li>
            <li>Single Home</li>
          </ul>
        </div>
        <div class="project-content">
          <h3 class="title">Coastal Harmony <br /> Home</h3>
          <p>Berlin, Germany <br /> 2025</p>
        </div>
      </div>
      <div class="project-item-2 antra-hover-view">
        <div class="project-thumb">
          <a href="/portfolio-details"
            ><OptimizedImage src="/assets/img/project/project-4.webp" alt="project" loading="lazy" /></a
          >
          <ul>
            <li>Residential</li>
            <li>Single Home</li>
          </ul>
        </div>
        <div class="project-content">
          <h3 class="title">Coastal Harmony <br /> Home</h3>
          <p>Berlin, Germany <br /> 2025</p>
        </div>
      </div>
      <div class="project-item-2 antra-hover-view">
        <div class="project-thumb">
          <a href="/portfolio-details"
            ><OptimizedImage src="/assets/img/project/project-2.webp" alt="project" loading="lazy" /></a
          >
          <ul>
            <li>Residential</li>
            <li>Single Home</li>
          </ul>
        </div>
        <div class="project-content">
          <h3 class="title">Coastal Harmony <br /> Home</h3>
          <p>Berlin, Germany <br /> 2025</p>
        </div>
      </div>
    </div>
  </div>
</section>
