---
import OptimizedImage from '../../ui/OptimizedImage.astro';
interface Props {}
---

<section class="project-section-3 pt-130 pb-130 overflow-hidden fade-wrapper tl-bg-color">
  <div class="container container-2">
    <div class="row section-heading-wrap fade-top ml-0">
      <div class="shape">
        <OptimizedImage src="/assets/img/shapes/section-heading.webp" alt="shape" loading="lazy" />
      </div>
      <div class="col-lg-4 col-md-12">
        <div class="section-heading mb-0">
          <h4
            class="sub-heading"
            data-text-animation="fade-in-right"
            data-split="char"
            data-duration="0.9"
            data-stagger="0.03"
          >
            FEATURED PROJECTS
          </h4>
        </div>
      </div>
      <div class="col-lg-8 col-md-12">
        <div class="section-heading section-heading-2 mb-0">
          <h2 class="section-title cursor-effect title-2">
            Creative <span>projects that <br /> define</span> our style
          </h2>
        </div>
      </div>
    </div>
    <div class="project-carousel-wrap-3 fade-top">
      <div class="project-carousel-2 swiper">
        <div class="swiper-wrapper">
          <div class="swiper-slide">
            <div class="project-item-3">
              <div class="project-img">
                <OptimizedImage src="/assets/img/project/project-3.webp" alt="project" loading="lazy" />
              </div>
              <div class="project-content">
                <ul>
                  <li><a href="/portfolio-details">Residential</a></li>
                  <li><a href="/portfolio-details">Single Home</a></li>
                </ul>
                <h3 class="title"><a href="/portfolio-details">Coastal Harmony Home</a></h3>
                <span>Berlin, Germany <br />2025</span>
              </div>
            </div>
          </div>
