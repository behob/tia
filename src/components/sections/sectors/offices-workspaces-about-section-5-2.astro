---
import OptimizedImage from '../../ui/OptimizedImage.astro';
interface Props {}
---
<section class="about-section-5 pt-130 pb-130 fade-wrapper tl-bg-color">
    <div class="shapes">
      <div class="shape-1"><OptimizedImage src="/assets/img/shapes/about-shape-3.webp" alt="shape" loading="lazy" /></div>
      <div class="shape-2"><OptimizedImage src="/assets/img/shapes/about-shape-4.webp" alt="shape" loading="lazy" /></div>
    </div>
    <div class="container container-2">
      <div class="row section-heading-wrap mw-100 fade-top">
        <div class="shape"><OptimizedImage src="/assets/img/shapes/section-heading.webp" alt="shape" loading="lazy" /></div>
        <div class="col-lg-4 col-md-12">
          <div class="section-heading mb-0">
            <h4
              class="sub-heading"
              data-text-animation="fade-in-right"
              data-split="char"
              data-duration="0.9"
              data-stagger="0.03"
            >
              About TIA
            </h4>
          </div>
        </div>
        <div class="col-lg-8 col-md-12">
          <div class="section-heading section-heading-2 mb-0">
            <h2 class="section-title cursor-effect title-2">
              We Shape <span>Interior Designs, <br />Crafting</span> Timeless and Inspiring <br />Spaces
            </h2>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-lg-4"></div>
        <div class="col-lg-8">
          <div class="about-content-5 fade-wrapper">
            <div class="about-img-1 fade-top">
              <OptimizedImage src="/assets/img/images/about-img-6.webp" alt="about" loading="lazy" />
            </div>
            <p class="about-desc fade-top">
              We believe that every space has the power to inspire, and that great design brings that inspiration to
              life. Our mission is to craft environments that stir creativity, evoke emotion, and reflect the essence of
              those who inhabit them.
            </p>
            <div class="about-bottom-content fade-top">
              <div class="left-content">
                <p>
                  We believe that every space has the power to inspire, and that great design brings that inspiration to
                  life. Our mission is to craft environments that stir creativity, evoke emotion, and reflect the
                  essence of those who inhabit them.
                </p>
                <div class="about-btn">
                  <a href="/about" class="tl-primary-btn"
                    >More about us <span class="icon"><i class="fa-regular fa-arrow-right"></i></span></a
                  >
                </div>
              </div>
              <ul>
                <li><i class="fa-solid fa-circle-chevron-right"></i>Best Office Interior Design, 2020</li>
                <li><i class="fa-solid fa-circle-chevron-right"></i>Winner of the InterYear, 2016</li>
                <li><i class="fa-solid fa-circle-chevron-right"></i>Best Home Design List in Germany, 2015</li>
                <li><i class="fa-solid fa-circle-chevron-right"></i>Industrial Design Award, 2018</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
