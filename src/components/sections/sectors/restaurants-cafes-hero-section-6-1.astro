---
interface Props {}
---

<section class="hero-section-6 overflow-hidden">
  <div
    class="bg-img"
    data-background="/assets/img/bg-img/hero-bg-1.webp"
    style="--bg-desktop:url('/assets/img/bg-img/hero-bg-1.webp');--bg-mobile:url('/assets/img/bg-img/hero-bg-1.webp')"
  >
  </div>
  <div class="hero-text"><span>Interior</span></div>
  <div class="container">
    <div class="hero-wrap-6 pt-130">
      <div class="hero-content-6 white-content">
        <div class="section-heading mb-0 white-content">
          <h4 class="sub-heading">Trusted Design Partner</h4>
          <h1 class="section-title cursor-effect">Find Your Inspired <br /><span>Interior Design</span></h1>
        </div>
        <div class="hero-content-left">
          <p>
            Transform your vision into reality with our innovative designs, creating modern spaces that blend
            functionality, aesthetics, and sustainability.
          </p>
          <div class="hero-btn">
            <a href="/service">Start <br /> Project</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
