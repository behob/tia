---
import OptimizedImage from '../../ui/OptimizedImage.astro';
interface Props {}
---

<section class="about-section-2 pt-130 pb-130 tl-bg-color">
  <div class="shape-1"><OptimizedImage src="/assets/img/shapes/about-shape-1.webp" alt="shape" loading="lazy" /></div>
  <div class="container container-2">
    <div class="row about-wrap-2">
      <div class="col-lg-8">
        <div class="about-content-left slide-anim" data-delay="0.3" data-offset="100" data-direction="left">
          <div class="section-heading">
            <h4
              class="sub-heading"
              data-text-animation="fade-in-right"
              data-split="char"
              data-duration="0.9"
              data-stagger="0.03"
            >
              Started In 1991
            </h4>
            <h2 class="section-title cursor-effect title-2">
              We Shape <span>Interior Designs, <br /> Crafting Timeless</span> and Inspiring <br /> Spaces
            </h2>
          </div>
          <div class="about-counter-wrap">
            <div class="counter-content">
              <h3 class="title"><span class="odometer" data-count="26">26</span></h3>
              <p>Years of <br /> experience</p>
            </div>
            <div class="counter-img">
              <OptimizedImage src="/assets/img/images/about-img-2.webp" alt="counter" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
      <div class="col-lg-4">
        <div class="about-content-right slide-anim" data-delay="0.3" data-offset="100" data-direction="right">
          <div class="about-img-1">
            <OptimizedImage src="/assets/img/images/about-img-3.webp" alt="about" loading="lazy" />
          </div>
          <div class="about-desc">
            <p>
              We believe that every space has the power to inspire, and that great design brings. Our mission is to
              craft environments that stir creativity, evoke emotion, and reflect the essence of those who inhabit them.
            </p>
            <div class="about-btn">
              <a href="/about" class="tl-primary-btn"
                >More About Us <span class="icon"><i class="fa-regular fa-arrow-right"></i></span></a
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
