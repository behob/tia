---
import OptimizedImage from '../../ui/OptimizedImage.astro';
interface Props {}
---
<section class="about-section-4 pt-130 pb-130 fade-wrapper tl-bg-color">
    <div class="container container-2">
      <div class="row section-heading-wrap fade-top">
        <div class="shape"><OptimizedImage src="/assets/img/shapes/section-heading.webp" alt="shape" loading="lazy" /></div>
        <div class="col-lg-4 col-md-12">
          <div class="section-heading mb-0">
            <h4
              class="sub-heading"
              data-text-animation="fade-in-right"
              data-split="char"
              data-duration="0.9"
              data-stagger="0.03"
            >
              About TIA
            </h4>
          </div>
        </div>
        <div class="col-lg-8 col-md-12">
          <div class="section-heading section-heading-2 mb-0">
            <h2 class="section-title cursor-effect title-2">
              We Shape <span>Interior Designs, <br />Crafting</span> Timeless and <br />Inspiring Spaces
            </h2>
          </div>
        </div>
      </div>
      <div class="row about-item-wrap gy-lg-0 gy-4 fade-wrapper">
        <div class="col-lg-4 col-md-6">
          <div class="about-item-4 antra-hover-view fade-top">
            <a href="/portfolio"><OptimizedImage src="/assets/img/images/about-item-img-1.webp" alt="about" loading="lazy" /></a>
          </div>
        </div>
        <div class="col-lg-4 col-md-6">
          <div class="about-item-4 antra-hover-view fade-top">
            <a href="/portfolio"><OptimizedImage src="/assets/img/images/about-item-img-2.webp" alt="about" loading="lazy" /></a>
          </div>
        </div>
        <div class="col-lg-4 col-md-6 antra-hover-view fade-top">
          <div class="about-item-4">
            <a href="/portfolio"><OptimizedImage src="/assets/img/images/about-item-img-3.webp" alt="about" loading="lazy" /></a>
          </div>
        </div>
      </div>
    </div>
  </section>
