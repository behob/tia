---
interface Props {}
---

<section class="cta-section-3">
  <div
    class="cta-bg"
    data-background="/assets/img/bg-img/cta-bg-1.webp"
    style="--bg-desktop:url('/assets/img/bg-img/cta-bg-1.webp');--bg-mobile:url('/assets/img/bg-img/cta-bg-1.webp')"
  >
  </div>
  <div class="container">
    <div class="cta-wrap-3 text-center fade-wrapper">
      <div class="section-heading text-center white-content fade-top">
        <h4
          class="sub-heading"
          data-text-animation="fade-in-right"
          data-split="char"
          data-duration="0.9"
          data-stagger="0.03"
        >
          YOUR BEST CHOICE
        </h4>
        <h2 class="section-title cursor-effect">Let's start <span>your new <br />dream</span> project</h2>
      </div>
      <div class="cta-btn-wrap fade-top">
        <a href="/contact" class="cta-btn">Get <br />a quote</a>
      </div>
    </div>
  </div>
</section>
