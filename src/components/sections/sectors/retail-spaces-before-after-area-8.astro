---
import OptimizedImage from '../../ui/OptimizedImage.astro';
interface Props {}
---
<div class="before-after-area fade-wrapper">
    <div class="bg-color"></div>
    <div class="container container-2 fade-top">
      <div class="twentytwenty-container antra-image-comparison">
        <OptimizedImage src="/assets/img/bg-img/before.webp" alt="before" loading="lazy" />
        <OptimizedImage src="/assets/img/bg-img/after.webp" alt="after" loading="lazy" />
      </div>
    </div>
  </div>
