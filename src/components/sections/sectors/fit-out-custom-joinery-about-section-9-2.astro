---
import OptimizedImage from '../../ui/OptimizedImage.astro';
interface Props {}
---
<section class="about-section-9 pt-130 pb-130 overflow-hidden fade-wrapper tl-bg-color">
    <div class="shape-1"><OptimizedImage src="/assets/img/shapes/about-shape-8.webp" alt="shape" loading="lazy" /></div>
    <div class="container container-2">
      <div class="row section-heading-wrap fade-top ml-0 mw-100">
        <div class="shape"><OptimizedImage src="/assets/img/shapes/section-heading.webp" alt="shape" loading="lazy" /></div>
        <div class="col-lg-4 col-md-12">
          <div class="section-heading mb-0">
            <h4
              class="sub-heading"
              data-text-animation="fade-in-right"
              data-split="char"
              data-duration="0.9"
              data-stagger="0.03"
            >
              About TIA
            </h4>
          </div>
        </div>
        <div class="col-lg-8 col-md-12">
          <div class="section-heading section-heading-2 mb-0">
            <h2 class="section-title cursor-effect title-2">
              We Shape <span>Interior Designs, <br />Crafting</span> Timeless and Inspiring <br />Spaces
            </h2>
          </div>
        </div>
      </div>
      <div class="about-img-9 fade-top">
        <OptimizedImage src="/assets/img/images/about-img-12.webp" alt="img" loading="lazy" />
      </div>
      <div class="about-content-9 fade-top">
        <div class="about-counter">
          <h3 class="title"><span class="odometer" data-count="26">26</span></h3>
          <p>years of work <br />experience</p>
        </div>
        <div class="about-desc">
          <p>
            Our mission is to create designs that make an impact. We aim to help businesses enhance their identity and
            communicate their story through sleek and functional design. Whether it's branding, web design, or UI/UX, we
            prioritize clarity, simplicity, and quality to ensure your brand connects with its audience in the most
            effective way.
          </p>
          <div class="about-btn">
            <a href="/about" class="tl-primary-btn"
              >More About Us <span class="icon"><i class="fa-regular fa-arrow-right"></i></span></a
            >
          </div>
        </div>
      </div>
    </div>
  </section>
