---
import OptimizedImage from '../../ui/OptimizedImage.astro';
interface Props {}
---
<section class="project-section-4 pb-130 overflow-hidden">
    <div class="project-item-wrap-2">
      <div class="project-item-2 project-item-4">
        <div class="project-thumb">
          <OptimizedImage src="/assets/img/project/project-big-1.webp" alt="project" loading="lazy" />
          <ul>
            <li>Residential</li>
            <li>Single Home</li>
          </ul>
          <span class="number">01</span>
        </div>
        <div class="project-content">
          <h3 class="title">Coastal Harmony <br /> Home</h3>
          <p>Berlin, Germany <br /> 2025</p>
        </div>
      </div>
      <div class="project-item-2 project-item-4">
        <div class="project-thumb">
          <OptimizedImage src="/assets/img/project/project-big-2.webp" alt="project" loading="lazy" />
          <ul>
            <li>Residential</li>
            <li>Single Home</li>
          </ul>
          <span class="number">02</span>
        </div>
        <div class="project-content">
          <h3 class="title">Coastal Harmony <br /> Home</h3>
          <p>Berlin, Germany <br /> 2025</p>
        </div>
      </div>
      <div class="project-item-2 project-item-4">
