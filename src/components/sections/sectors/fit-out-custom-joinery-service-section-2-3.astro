---
import OptimizedImage from '../../ui/OptimizedImage.astro';
interface Props {}
---

<section class="service-section-2 fade-wrapper bg-grey pt-130 pb-130 service-9">
  <div class="service-text"><span>tia</span></div>
  <div class="service-element scroll-area">
    <OptimizedImage class="scroll-img" src="/assets/img/images/counter-img-1.webp" alt="counter" loading="lazy" />
  </div>
  <div class="container container-2">
    <div class="row section-heading-wrap fade-top">
      <div class="shape">
        <OptimizedImage src="/assets/img/shapes/section-heading.webp" alt="shape" loading="lazy" />
      </div>
      <div class="col-lg-4 col-md-12">
        <div class="section-heading mb-0">
          <h4
            class="sub-heading"
            data-text-animation="fade-in-right"
            data-split="char"
            data-duration="0.9"
            data-stagger="0.03"
          >
            Our Services
          </h4>
        </div>
      </div>
      <div class="col-lg-8 col-md-12">
        <div class="section-heading section-heading-2 mb-0">
          <h2 class="section-title cursor-effect title-2">
            Explore our <span>comprehensive <br /> interior design</span> services
          </h2>
        </div>
      </div>
    </div>
    <div class="service-carousel swiper fade-top">
      <div class="swiper-wrapper">
        <div class="swiper-slide">
          <div class="service-item-2">
            <div class="service-thumb">
              <OptimizedImage src="/assets/img/service/service-img-1.webp" alt="service" loading="lazy" />
              <span class="number">01</span>
            </div>
            <div class="service-content">
              <h5 class="title"><a href="/service-details">Residential Interior Design</a></h5>
              <p>
                Tailored design services for private homes, including room makeovers and complete home transformations.
              </p>
            </div>
          </div>
        </div>
        <div class="swiper-slide">
          <div class="service-item-2">
            <div class="service-thumb">
              <OptimizedImage src="/assets/img/service/service-img-2.webp" alt="service" loading="lazy" />
              <span class="number">02</span>
            </div>
            <div class="service-content">
              <h5 class="title"><a href="/service-details">Renovation and Remodeling</a></h5>
              <p>
                Tailored design services for private homes, including room makeovers and complete home transformations.
              </p>
            </div>
          </div>
        </div>
        <div class="swiper-slide">
          <div class="service-item-2">
            <div class="service-thumb">
              <OptimizedImage src="/assets/img/service/service-img-3.webp" alt="service" loading="lazy" />
              <span class="number">03</span>
            </div>
            <div class="service-content">
              <h5 class="title"><a href="/service-details">Commercial Interior Design</a></h5>
              <p>
                Tailored design services for private homes, including room makeovers and complete home transformations.
              </p>
            </div>
          </div>
        </div>
        <div class="swiper-slide">
          <div class="service-item-2">
            <div class="service-thumb">
              <OptimizedImage src="/assets/img/service/service-img-4.webp" alt="service" loading="lazy" />
              <span class="number">04</span>
            </div>
            <div class="service-content">
              <h5 class="title"><a href="/service-details">Interior Design Consultation</a></h5>
              <p>
                Tailored design services for private homes, including room makeovers and complete home transformations.
              </p>
            </div>
          </div>
        </div>
        <div class="swiper-slide">
          <div class="service-item-2">
            <div class="service-thumb">
              <OptimizedImage src="/assets/img/service/service-img-5.webp" alt="service" loading="lazy" />
              <span class="number">05</span>
            </div>
            <div class="service-content">
              <h5 class="title"><a href="/service-details">Outdoor & Landscape Design</a></h5>
              <p>
                Tailored design services for private homes, including room makeovers and complete home transformations.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
