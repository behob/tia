---
import OptimizedImage from '../../ui/OptimizedImage.astro';
interface Props {}
---

<section class="team-section-7 bg-grey pt-130 pb-130 fade-wrapper">
  <div class="container container-2">
    <div class="row section-heading-wrap ml-0 mw-100 fade-top">
      <div class="shape">
        <OptimizedImage src="/assets/img/shapes/section-heading.webp" alt="shape" loading="lazy" />
      </div>
      <div class="col-lg-4 col-md-12">
        <div class="section-heading mb-0">
          <h4
            class="sub-heading"
            data-text-animation="fade-in-right"
            data-split="char"
            data-duration="0.9"
            data-stagger="0.03"
          >
            Popular Queries
          </h4>
        </div>
      </div>
      <div class="col-lg-8 col-md-12">
        <div class="section-heading section-heading-2 mb-0">
          <h2 class="section-title cursor-effect title-2">
            Quick and clear <span>answers <br /> to your key</span> questions
          </h2>
        </div>
      </div>
    </div>
    <div class="row gy-lg-0 gy-5 fade-wrapper">
      <div class="col-lg-3 col-md-6 fade-top">
        <div class="team-item-7">
          <div class="team-thumb">
            <OptimizedImage src="/assets/img/team/team-img-1.webp" alt="team" loading="lazy" />
            <ul class="team-social">
              <li>
                <a href="https://www.facebook.com/tia.interior.dubai" aria-label="TIA Interior on Facebook"
                  ><i class="fa-brands fa-facebook-f"></i></a>
              </li>
              <li>
                <a href="https://www.instagram.com/tia.interior.dubai/" aria-label="TIA Interior on Instagram"
                  ><i class="fa-brands fa-instagram"></i></a>
              </li>
              <li><span aria-hidden="true"><i class="fa-brands fa-pinterest"></i></span></li>
              <li><span aria-hidden="true"><i class="fa-brands fa-behance"></i></span></li>
            </ul>
          </div>
          <div class="team-content text-center">
            <h3 class="title"><a href="/team-details">Mark Jackson</a></h3>
            <span>Co-Founder & CEO</span>
          </div>
        </div>
      </div>
      <div class="col-lg-3 col-md-6 fade-top">
        <div class="team-item-7">
          <div class="team-thumb">
            <OptimizedImage src="/assets/img/team/team-img-2.webp" alt="team" loading="lazy" />
            <ul class="team-social">
              <li>
                <a href="https://www.facebook.com/tia.interior.dubai" aria-label="TIA Interior on Facebook"
                  ><i class="fa-brands fa-facebook-f"></i></a>
              </li>
              <li>
                <a href="https://www.instagram.com/tia.interior.dubai/" aria-label="TIA Interior on Instagram"
                  ><i class="fa-brands fa-instagram"></i></a>
              </li>
              <li><span aria-hidden="true"><i class="fa-brands fa-pinterest"></i></span></li>
              <li><span aria-hidden="true"><i class="fa-brands fa-behance"></i></span></li>
            </ul>
          </div>
          <div class="team-content text-center">
            <h3 class="title"><a href="/team-details">Nathaniel Brooks</a></h3>
            <span>Co-Founder & CEO</span>
          </div>
        </div>
      </div>
      <div class="col-lg-3 col-md-6 fade-top">
        <div class="team-item-7">
          <div class="team-thumb">
            <OptimizedImage src="/assets/img/team/team-img-3.webp" alt="team" loading="lazy" />
            <ul class="team-social">
              <li>
                <a href="https://www.facebook.com/tia.interior.dubai" aria-label="TIA Interior on Facebook"
                  ><i class="fa-brands fa-facebook-f"></i></a>
              </li>
              <li>
                <a href="https://www.instagram.com/tia.interior.dubai/" aria-label="TIA Interior on Instagram"
                  ><i class="fa-brands fa-instagram"></i></a>
              </li>
              <li><span aria-hidden="true"><i class="fa-brands fa-pinterest"></i></span></li>
              <li><span aria-hidden="true"><i class="fa-brands fa-behance"></i></span></li>
            </ul>
          </div>
          <div class="team-content text-center">
            <h3 class="title"><a href="/team-details">Henry Caldwell</a></h3>
            <span>Co-Founder & CEO</span>
          </div>
        </div>
      </div>
      <div class="col-lg-3 col-md-6 fade-top">
        <div class="team-item-7">
          <div class="team-thumb">
            <OptimizedImage src="/assets/img/team/team-img-4.webp" alt="team" loading="lazy" />
            <ul class="team-social">
              <li>
                <a href="https://www.facebook.com/tia.interior.dubai" aria-label="TIA Interior on Facebook"
                  ><i class="fa-brands fa-facebook-f"></i></a>
              </li>
              <li>
                <a href="https://www.instagram.com/tia.interior.dubai/" aria-label="TIA Interior on Instagram"
                  ><i class="fa-brands fa-instagram"></i></a>
              </li>
              <li><span aria-hidden="true"><i class="fa-brands fa-pinterest"></i></span></li>
              <li><span aria-hidden="true"><i class="fa-brands fa-behance"></i></span></li>
            </ul>
          </div>
          <div class="team-content text-center">
            <h3 class="title"><a href="/team-details">Carlos Rivera</a></h3>
            <span>Co-Founder & CEO</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
