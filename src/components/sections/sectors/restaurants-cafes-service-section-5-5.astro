---
import OptimizedImage from '../../ui/OptimizedImage.astro';
interface Props {}
---
<section class="service-section-5 pt-130 pb-130 fade-wrapper">
    <div class="bg-img" data-background="/assets/img/bg-img/service-bg-2.webp" style="--bg-desktop:url('/assets/img/bg-img/service-bg-2.webp');--bg-mobile:url('/assets/img/bg-img/service-bg-2.webp')"></div>
    <div class="container container-2">
      <div class="row section-heading-wrap fade-top">
        <div class="shape"><OptimizedImage src="/assets/img/shapes/section-heading-2.webp" alt="shape" loading="lazy" /></div>
        <div class="col-lg-4 col-md-12">
          <div class="section-heading mb-0 white-content">
            <h4
              class="sub-heading"
              data-text-animation="fade-in-right"
              data-split="char"
              data-duration="0.9"
              data-stagger="0.03"
            >
              Our Services
            </h4>
          </div>
        </div>
        <div class="col-lg-8 col-md-12">
          <div class="section-heading section-heading-2 mb-0 white-content">
            <h2 class="section-title cursor-effect title-2">
              Explore our <span>comprehensive <br />interior design</span> services
            </h2>
          </div>
        </div>
      </div>
      <div class="row gy-lg-0 gy-4 fade-wrapper">
        <div class="col-lg-4 col-md-6 fade-top">
          <div class="service-item-5">
            <div class="service-content">
              <h3 class="title">
                <a href="/service-details">Residential Interior <br />Design</a>
                <span class="number">01</span>
              </h3>
              <p>
                Tailored design services for private homes, including room makeovers and complete home transformations.
              </p>
            </div>
            <div class="service-img">
              <OptimizedImage src="/assets/img/service/service-img-8.webp" alt="service" loading="lazy" />
            </div>
          </div>
        </div>
        <div class="col-lg-4 col-md-6 fade-top">
          <div class="service-item-5 item-2">
            <div class="service-content">
              <h3 class="title">
                <a href="/service-details">Commercial Interior <br /> Design</a>
                <span class="number">02</span>
              </h3>
              <p>
                Tailored design services for private homes, including room makeovers and complete home transformations.
              </p>
            </div>
            <div class="service-img">
              <OptimizedImage src="/assets/img/service/service-img-9.webp" alt="service" loading="lazy" />
            </div>
          </div>
        </div>
        <div class="col-lg-4 col-md-6 fade-top">
          <div class="service-item-5">
            <div class="service-content">
              <h3 class="title">
                <a href="/service-details">Interior Design <br />Consultation</a>
                <span class="number">03</span>
              </h3>
              <p>
                Tailored design services for private homes, including room makeovers and complete home transformations.
              </p>
            </div>
            <div class="service-img">
              <OptimizedImage src="/assets/img/service/service-img-10.webp" alt="service" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
