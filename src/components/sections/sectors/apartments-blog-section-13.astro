---
import OptimizedImage from '../../ui/OptimizedImage.astro';
import { getBlogPosts } from '../../../data/blog';
const blogDates = new Map((await getBlogPosts()).map(post => [post.slug, post.date]));
interface Props {}
---
<section class="blog-section pt-150 fade-wrapper tl-bg-color">
    <div class="container container-2">
      <div class="row section-heading-wrap fade-top">
        <div class="shape"><OptimizedImage src="/assets/img/shapes/section-heading.webp" alt="shape" loading="lazy" /></div>
        <div class="col-lg-4 col-md-12">
          <div class="section-heading mb-0">
            <h4
              class="sub-heading"
              data-text-animation="fade-in-right"
              data-split="char"
              data-duration="0.9"
              data-stagger="0.03"
            >
              amazing design team
            </h4>
          </div>
        </div>
        <div class="col-lg-8 col-md-12">
          <div class="section-heading section-heading-2 mb-0">
            <h2 class="section-title cursor-effect title-2">
              Meet the <span>Experts Our <br /> interior</span> designers
            </h2>
          </div>
        </div>
      </div>
      <div class="row gy-lg-0 gy-4 fade-wrapper">
        <div class="col-lg-6 col-md-6 fade-top">
          <div class="post-card post-card-2 pr-10">
            <div class="post-thumb">
              <OptimizedImage src="/assets/img/blog/post-4.webp" alt="post" loading="lazy" />
              <span class="category">tips & trick</span>
            </div>
            <div class="post-content">
              <ul class="post-meta">
                <li>{blogDates.get('four-ways-for-creating-extra-space-in-small-homes')}</li>
                <li>By <span>Admin</span></li>
              </ul>
              <h3 class="title"><a href="/blog/four-ways-for-creating-extra-space-in-small-homes">Four Ways for Creating Extra Space <br />in Small Homes</a></h3>
              <p>
                Modest, recently established interior design company that seeks to address a variety of topics,
                including…
              </p>
            </div>
          </div>
        </div>
        <div class="col-lg-6 col-md-6 fade-top">
          <div class="post-card-wrap">
            <div class="post-card">
              <div class="post-thumb">
                <OptimizedImage src="/assets/img/blog/post-5.webp" alt="post" loading="lazy" />
                <span class="category">exteriors</span>
              </div>
              <div class="post-content">
                <ul class="post-meta">
                  <li>{blogDates.get('how-does-one-go-about-buying-furniture')}</li>
                  <li>By <span>Admin</span></li>
                </ul>
                <h3 class="title"><a href="/blog/how-does-one-go-about-buying-furniture">How Does One Go About Buying Furniture?</a></h3>
                <p>
                  Modest, recently established interior design company that seeks to address a variety of topics,
                  including…
                </p>
              </div>
            </div>
            <div class="post-card">
              <div class="post-thumb">
                <OptimizedImage src="/assets/img/blog/post-6.webp" alt="post" loading="lazy" />
                <span class="category">exteriors</span>
              </div>
              <div class="post-content">
                <ul class="post-meta">
                  <li>{blogDates.get('how-does-one-go-about-buying-furniture')}</li>
                  <li>By <span>Admin</span></li>
                </ul>
                <h3 class="title"><a href="/blog/how-does-one-go-about-buying-furniture">How Does One Go About Buying Furniture?</a></h3>
                <p>
                  Modest, recently established interior design company that seeks to address a variety of topics,
                  including…
                </p>
              </div>
            </div>
            <div class="post-card">
              <div class="post-thumb">
                <OptimizedImage src="/assets/img/blog/post-7.webp" alt="post" loading="lazy" />
                <span class="category">exteriors</span>
              </div>
              <div class="post-content">
                <ul class="post-meta">
                  <li>{blogDates.get('how-does-one-go-about-buying-furniture')}</li>
                  <li>By <span>Admin</span></li>
                </ul>
                <h3 class="title"><a href="/blog/how-does-one-go-about-buying-furniture">How Does One Go About Buying Furniture?</a></h3>
                <p>
                  Modest, recently established interior design company that seeks to address a variety of topics,
                  including…
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
