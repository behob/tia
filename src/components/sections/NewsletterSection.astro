---
interface Props {
  extraClass?: string;
}

const { extraClass = '' } = Astro.props;
---

<section class={`newsletter-section bg-white pb-130 overflow-hidden ${extraClass}`}>
  <div class="bg-shape"><img src="/assets/img/shapes/newsletter-shape.webp" alt="shape" loading="lazy" /></div>
  <div class="container">
    <div class="newsletter-wrap">
      <div class="section-heading text-center">
        <h4
          class="sub-heading"
          data-text-animation="fade-in-right"
          data-split="char"
          data-duration="0.9"
          data-stagger="0.03"
        >
          Subscribe to the newsletter
        </h4>
        <h2 class="section-title cursor-effect">Join <span>our newsletter <br /> stay</span> up to date</h2>
        <p>
          Join our newsletter. Learn something new, gain access to exclusive content, <br /> and stay informed with the latest
          updates in the industry.
        </p>
      </div>
      <div class="newsletter-form">
        <input type="text" id="email" name="email" class="form-control" placeholder="Email address.." />
        <button type="submit"><i class="fa-regular fa-arrow-right-long"></i></button>
      </div>
    </div>
  </div>
</section>
