---
import NewsletterForm from './NewsletterForm.astro';
import OptimizedImage from '../ui/OptimizedImage.astro';
interface Props {
  extraClass?: string;
  sectionClass?: string;
}

const { extraClass = '', sectionClass = `newsletter-section bg-white pb-130 overflow-hidden ${extraClass}` } = Astro.props;
---

<section class={sectionClass}>
  <div class="bg-shape"><OptimizedImage src="/assets/img/shapes/newsletter-shape.webp" alt="shape" loading="lazy" /></div>
  <div class="container">
    <div class="newsletter-wrap">
      <div class="section-heading text-center">
        <h4
          class="sub-heading"
          data-text-animation="fade-in-right"
          data-split="char"
          data-duration="0.9"
          data-stagger="0.03"
        >
          Subscribe to the newsletter
        </h4>
        <h2 class="section-title cursor-effect">Join <span>our newsletter <br /> stay</span> up to date</h2>
        <p>
          Join our newsletter. Learn something new, gain access to exclusive content, <br /> and stay informed with the latest
          updates in the industry.
        </p>
      </div>
      <NewsletterForm />
    </div>
  </div>
</section>
