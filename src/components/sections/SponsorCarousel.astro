---
import OptimizedImage from '../ui/OptimizedImage.astro';
import { sponsors } from '../../data/sponsors';
---

<section class="sponsor-section bg-white pt-120 pb-130 overflow-hidden">
  <div class="container">
    <div class="sponsor-text-wrap sponsor-text-wrap-2">
      <h5 class="sponsor-text">Our Website <span>75000</span>+ VIP Customer</h5>
    </div>
    <div class="sponsor-carousel swiper">
      <div class="swiper-wrapper">
        {
          sponsors.map((sponsor) => (
            <div class="swiper-slide">
              <div class="sponsor-item">
                <a href="#" aria-label={sponsor.alt}>
                  <OptimizedImage src={sponsor.image} alt={sponsor.alt} width={sponsor.width} height={sponsor.height} loading="lazy" />
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
