---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import NewsletterSection from '../components/sections/NewsletterSection.astro';
---

<Layout
  title="About Us - TIA Interior"
  description="Learn about TIA Interior, a luxury interior design and architecture studio based in Dubai with over 26 years of experience."
>
  <PageHeader title="About Us" currentPage="About Us" />

  <section class="about-section-2 pt-130 pb-130">
    <div class="shape-1"><img src="/assets/img/shapes/about-shape-1.png" alt="shape" loading="lazy" /></div>
    <div class="container container-2">
      <div class="row about-wrap-2">
        <div class="col-lg-8">
          <div class="about-content-left">
            <div class="section-heading">
              <h4
                class="sub-heading"
                data-text-animation="fade-in-right"
                data-split="char"
                data-duration="0.9"
                data-stagger="0.03"
              >
                Started In 1991
              </h4>
              <h2 class="section-title title-2">
                We Shape <span>Interior Designs, <br /> Crafting Timeless</span> and Inspiring <br /> Spaces
              </h2>
            </div>
            <div class="about-counter-wrap">
              <div class="counter-content">
                <h3 class="title"><span class="odometer" data-count="26">0</span></h3>
                <p>Years of <br /> experience</p>
              </div>
              <div class="counter-img">
                <img src="/assets/img/images/about-img-2.png" alt="counter" loading="lazy" />
              </div>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="about-content-right">
            <div class="about-img-1">
              <img src="/assets/img/images/about-img-3.png" alt="about" loading="lazy" />
            </div>
            <div class="about-desc">
              <p>
                We believe that every space has the power to inspire, and that great design brings. Our mission is to
                craft environments that stir creativity, evoke emotion, and reflect the essence of those who inhabit
                them.
              </p>
              <div class="about-btn">
                <a href="/about" class="tl-primary-btn"
                  >More About Us <span class="icon"><i class="fa-regular fa-arrow-right"></i></span></a
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="video-area-wrap">
    <div class="video-bg" data-background="/assets/img/bg-img/video-bg-3.png"></div>
    <div class="play-btn">
      <a class="video-popup venobox" data-autoplay="true" data-vbtype="video" href="https://youtu.be/JwC-Qx1lJso"
        >play</a
      >
    </div>
  </div>

  <section class="history-section pt-130 pb-130">
    <div class="history-text"><span>tia</span></div>
    <div class="history-element"><img src="/assets/img/images/counter-img-1.png" alt="counter" loading="lazy" /></div>
    <div class="container container-2">
      <div class="row section-heading-wrap ml-0 mw-100">
        <div class="shape"><img src="/assets/img/shapes/section-heading.png" alt="shape" loading="lazy" /></div>
        <div class="col-lg-4 col-md-12">
          <div class="section-heading mb-0">
            <h4
              class="sub-heading"
              data-text-animation="fade-in-right"
              data-split="char"
              data-duration="0.9"
              data-stagger="0.03"
            >
              our History
            </h4>
          </div>
        </div>
        <div class="col-lg-8 col-md-12">
          <div class="section-heading section-heading-2 mb-0">
            <h2 class="section-title title-2">
              Our history <span>is full of <br /> interesting</span> stages <br /> and events.
            </h2>
          </div>
        </div>
      </div>
      <div class="history-carousel-wrap">
        <div class="history-carousel swiper">
          <div class="swiper-wrapper">
            {
              Array.from({ length: 6 }).map((_, i) => (
                <div class="swiper-slide">
                  <div class="history-item">
                    <div class="history-img">
                      <img src="/assets/img/images/history-img-1.png" alt="history" loading="lazy" />
                    </div>
                    <div class="history-content">
                      <div class="circle" />
                      <h3 class="title">
                        <a href="/about">2025</a>
                      </h3>
                      <p>Celebrates 15 years with a retrospective showcase of the company's projects and milestones.</p>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="process-section overflow-hidden bg-white">
    <div class="bg-shape" data-background="/assets/img/shapes/process-shape-1.png"></div>
    <div class="container container-2">
      <div class="heading-space align-items-end">
        <div class="section-heading mb-0">
          <h4
            class="sub-heading"
            data-text-animation="fade-in-right"
            data-split="char"
            data-duration="0.9"
            data-stagger="0.03"
          >
            How We Work
          </h4>
          <h2 class="section-title title-2">
            Description <span>Architecture <br /> process</span> for exceptional <br /> results.
          </h2>
        </div>
        <div class="process-desc">
          <p class="mb-0">
            Our process is alive - adapting, refining, and growing <br /> with your vision. Always. <br /> Like artists with
            a blank canvas, we transform rooms <br /> into living works of art.
          </p>
        </div>
      </div>
      <div class="row gy-xl-0 gy-4 process-wrap">
        {
          [
            { num: '01', title: 'Initial Consultation', img: '/assets/img/images/process-img-1.png' },
            { num: '02', title: 'Design & Planning', img: '/assets/img/images/process-img-2.png' },
            { num: '03', title: 'Implementation', img: '/assets/img/images/process-img-3.png' },
            { num: '04', title: 'Project Handover', img: '/assets/img/images/process-img-4.png' },
          ].map((step) => (
            <div class="col-xl-3 col-lg-6 col-md-6">
              <div class="process-item">
                <div class="process-thumb">
                  <img src={step.img} alt={step.title} loading="lazy" />
                </div>
                <div class="process-content">
                  <h3 class="title">
                    <span>{step.num}</span>. {step.title}
                  </h3>
                  <p>
                    We begin by understanding <br /> your vision, goals, and needs, <br /> followed by our expert
                    execution.
                  </p>
                </div>
                <span class="number">{step.num}</span>
              </div>
            </div>
          ))
        }
      </div>
      <div class="process-text">
        <h5 class="bottom-text">We've been working hard to impress you. <a href="/contact">Start yours today</a></h5>
      </div>
    </div>
  </section>

  <section class="award-section bg-grey pt-130 pb-130">
    <div class="bg-shape"><img src="/assets/img/shapes/team-bg-shape-1.png" alt="shape" loading="lazy" /></div>
    <div class="container container-2">
      <div class="row section-heading-wrap">
        <div class="shape"><img src="/assets/img/shapes/section-heading.png" alt="shape" loading="lazy" /></div>
        <div class="col-lg-4 col-md-12">
          <div class="section-heading mb-0">
            <h4
              class="sub-heading"
              data-text-animation="fade-in-right"
              data-split="char"
              data-duration="0.9"
              data-stagger="0.03"
            >
              Award & achievement
            </h4>
          </div>
        </div>
        <div class="col-lg-8 col-md-12">
          <div class="section-heading section-heading-2 mb-0">
            <h2 class="section-title title-2">Design That <span>Speaks Our <br /> Industry</span> Awards</h2>
          </div>
        </div>
      </div>
      <div class="row award-wrap">
        <div class="col-lg-5">
          <div class="award-img">
            <img src="/assets/img/images/award-img-1.png" alt="award" loading="lazy" />
          </div>
        </div>
        <div class="col-lg-7">
          <div class="award-item-list">
            {
              [
                { year: '2025', title: 'Best Residential Design', category: 'Interior Design', img: 'award-img-1.png' },
                { year: '2024', title: 'Top Commercial Design', category: 'Architecture', img: 'award-img-2.jpg' },
                {
                  year: '2023',
                  title: 'Sustainable Design Award',
                  category: 'Community Center',
                  img: 'award-img-3.jpg',
                },
                {
                  year: '2022',
                  title: 'Creative Office Space Award',
                  category: 'Corporation Building',
                  img: 'award-img-4.jpg',
                },
                {
                  year: '2020',
                  title: 'Emerging Designer of the Year',
                  category: 'Interior Design',
                  img: 'award-img-5.jpg',
                },
              ].map((award) => (
                <div class="award-item" data-img={`assets/img/images/${award.img}`}>
                  <div class="left-content">
                    <span class="number">{award.year}</span>
                    <h3 class="title">{award.title}</h3>
                  </div>
                  <div class="mid-content">
                    <span>{award.category}</span>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="gallary-section-2 pb-130 overflow-hidden">
    <div class="bg-img" data-background="/assets/img/bg-img/gallary-bg-1.png"></div>
    <div class="container container-2">
      <div class="row">
        <div class="col-lg-4 col-md-12">
          <div class="gallary-left-content">
            <div class="section-heading white-content mb-0">
              <h4
                class="sub-heading"
                data-text-animation="fade-in-right"
                data-split="char"
                data-duration="0.9"
                data-stagger="0.03"
              >
                our gallery
              </h4>
              <h2 class="section-title">Interior <br /> design</h2>
              <p class="mb-0">
                Transforming visions into stunning spaces. <br /> Explore our portfolio of innovative projects <br /> crafted
                with precision.
              </p>
            </div>
          </div>
        </div>
        <div class="col-lg-8">
          <div class="gallary-carousel-wrap">
            <div class="gallary-carousel swiper">
              <div class="swiper-wrapper">
                {
                  [1, 2, 3, 4].map((i) => (
                    <div class="swiper-slide">
                      <div class="gallary-inner-item">
                        <a href="/about">
                          <img src={`/assets/img/images/gallary-img-${i}.png`} alt={`gallery ${i}`} loading="lazy" />
                        </a>
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
            <div class="swiper-arrow">
              <div class="swiper-nav swiper-prev"><i class="fa-regular fa-arrow-left"></i></div>
              <div class="swiper-nav swiper-next"><i class="fa-regular fa-arrow-right"></i></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="testimonial-section bg-white pt-150">
    <div class="container container-2">
      <div class="row section-heading-wrap">
        <div class="shape"><img src="/assets/img/shapes/section-heading.png" alt="shape" loading="lazy" /></div>
        <div class="col-lg-4 col-md-12">
          <div class="section-heading mb-0">
            <h4
              class="sub-heading"
              data-text-animation="fade-in-right"
              data-split="char"
              data-duration="0.9"
              data-stagger="0.03"
            >
              Our clients say
            </h4>
          </div>
        </div>
        <div class="col-lg-8 col-md-12">
          <div class="section-heading section-heading-2 mb-0">
            <h2 class="section-title title-2">Here's What <span>warm words <br /> our clients</span> say</h2>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-lg-6">
          <div class="testi-img">
            <img src="/assets/img/testi/testi-img-1.png" alt="testimonial" loading="lazy" />
          </div>
        </div>
        <div class="col-lg-6">
          <div class="testi-carousel-wrap">
            <div class="testi-top-content">
              <div class="left-content">
                <h3 class="rating">4.80</h3>
                <div class="rating-list">
                  <ul>
                    <li><i class="fa-solid fa-star"></i></li>
                    <li><i class="fa-solid fa-star"></i></li>
                    <li><i class="fa-solid fa-star"></i></li>
                    <li><i class="fa-solid fa-star"></i></li>
                    <li><i class="fa-solid fa-star"></i></li>
                  </ul>
                  <span>2,688 reviews</span>
                </div>
              </div>
              <div class="right-content">
                <p>
                  From concept to reality, the team turned my <br /> vision into a stunning, livable space. I couldn't <br
                  /> be happier with this!
                </p>
              </div>
            </div>
            <div class="testi-carousel swiper">
              <div class="swiper-wrapper">
                <div class="swiper-slide">
                  <div class="testi-item">
                    <p>
                      "A wonderful experience! They knew what they were doing and were incredibly knowledgeable
                      throughout the process."
                    </p>
                    <div class="testi-author">
                      <div class="author-img">
                        <img src="/assets/img/testi/testi-author-1.png" alt="author" loading="lazy" />
                      </div>
                      <h4 class="name">Morgan Dufresne <span>Company Owner</span></h4>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sponsor-section bg-white pt-120 pb-130 overflow-hidden">
    <div class="container">
      <div class="sponsor-text-wrap sponsor-text-wrap-2">
        <h5 class="sponsor-text">Our Website <span>75000</span>+ VIP Customer</h5>
      </div>
      <div class="sponsor-carousel swiper">
        <div class="swiper-wrapper">
          {
            [1, 2, 3, 4, 5, 6].map((i) => (
              <div class="swiper-slide">
                <div class="sponsor-item">
                  <a href="#">
                    <img src={`/assets/img/sponsor/sponsor-${i}.png`} alt={`sponsor ${i}`} loading="lazy" />
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <NewsletterSection />
</Layout>
