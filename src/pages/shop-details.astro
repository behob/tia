---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';

const relatedProducts = [
  { image: '/assets/img/shop/shop-1.webp', name: 'Modern Caramel Fabric Sofa', price: '$157.00' },
  { image: '/assets/img/shop/shop-2.webp', name: 'Modern Caramel Fabric Sofa', price: '$157.00' },
  { image: '/assets/img/shop/shop-3.webp', name: 'Modern Caramel Fabric Sofa', price: '$157.00' },
  { image: '/assets/img/shop/shop-4.webp', name: 'Modern Caramel Fabric Sofa', price: '$157.00' },
];

const reviews = [
  {
    author: 'Eleanor Fant',
    image: '/assets/img/shop/review-list-1.webp',
    date: '06 March, 2026',
    text: 'Designed very similarly to the nearly double priced Galaxy tab S6, with the only removal being.',
  },
  {
    author: 'Haliey White',
    image: '/assets/img/shop/review-list-2.webp',
    date: '06 March, 2026',
    text: 'Designed very similarly to the nearly double priced Galaxy tab S6, with the only removal being.',
  },
];

const paymentIcons = [1, 2, 3, 4, 5, 6, 7];
---

<Layout title="Shop Details - TIA Interior" description="Product details for our curated furniture collection.">
  <PageHeader title="Shop Details" currentPage="Product Details" />

  <section class="shop-section single pt-100 pb-100">
    <div class="container container-2">
      <div class="row">
        <div class="col-lg-6 product-details-wrap">
          <div class="product-details-img">
            <img src="/assets/img/shop/shop-img-1.webp" alt="product" loading="lazy" />
          </div>
        </div>
        <div class="col-lg-6">
          <div class="product-details">
            <div class="product-info">
              <div class="product-inner">
                <span class="category">Save -20%</span>
                <h3 class="title">Modern Caramel Fabric Sofa</h3>
                <div class="rating-wrap">
                  <span class="brand">Brands: <span>TIA</span></span>
                  <span class="review">
                    <ul class="rating">
                      {
                        [1, 2, 3, 4, 5].map(() => (
                          <li>
                            <i class="fa-sharp fa-solid fa-star" />
                          </li>
                        ))
                      }
                    </ul>
                    ( 3 Reviews )
                  </span>
                  <span class="stock"><i class="fa-regular fa-check"></i> In Stock</span>
                </div>
                <h4 class="price">$260.00 <span>$360.00</span></h4>
                <p class="pricing-desc">
                  Luxury fabric sofa with premium craftsmanship. Perfect for modern living spaces with elegant design
                  and exceptional comfort.
                </p>
              </div>
              <h4 class="quantity-title">Quantity:</h4>
              <div class="product-btn">
                <form>
                  <input type="number" name="quantity" min="1" max="100" step="1" value="1" />
                </form>
                <div class="cart-btn-wrap-2"><a href="#" class="cp-primary-btn cart-btn">Add To Cart</a></div>
              </div>
              <ul class="product-meta">
                <li><a href="#"><i class="fa-regular fa-heart"></i> Add to wishlist</a></li>
                <li><a href="#"><i class="fa-regular fa-recycle"></i> Compare</a></li>
              </ul>
              <div class="payment-card-wrap">
                <span class="card-title">Guarantee Safe & Secure Checkout</span>
                <ul>
                  {
                    paymentIcons.map((i) => (
                      <li>
                        <a href="#">
                          <img src={`/assets/img/icon/shop-icon-${i}.webp`} alt="payment" loading="lazy" />
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
              <ul class="product-list">
                <li><span>Categories:</span> Interior, Furniture</li>
                <li><span>Tags:</span> Sofa, Living Room</li>
                <li><span>SKU:</span> TIA-068</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="product-description pb-100">
    <div class="container container-2">
      <ul class="nav tab-navigation" id="product-tab-navigation" role="tablist">
        <li role="presentation">
          <button class="active" id="home-tab" data-bs-toggle="tab" data-bs-target="#home" type="button" role="tab"
            >Description</button>
        </li>
        <li role="presentation">
          <button id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile" type="button" role="tab"
            >Additional information</button>
        </li>
        <li role="presentation">
          <button id="contact-tab" data-bs-toggle="tab" data-bs-target="#contact" type="button" role="tab"
            >Reviews (3)</button>
        </li>
      </ul>
      <div class="tab-content" id="product-tab-content">
        <div class="tab-pane fade show active description" id="home" role="tabpanel">
          <div class="desc-wrap">
            <p>
              Must explain to you how all this mistaken idea of denouncing pleasure and praising pain was born and I
              will give you a complete account of the system, and expound the actual teachings of the great explorer of
              the truth.
            </p>
            <div class="desc-list-wrap">
              <ul>
                <li><i class="fa-solid fa-check"></i> Premium quality fabric upholstery</li>
                <li><i class="fa-solid fa-check"></i> Solid wood frame construction</li>
                <li><i class="fa-solid fa-check"></i> High-density foam cushions</li>
                <li><i class="fa-solid fa-check"></i> Easy assembly required</li>
                <li><i class="fa-solid fa-check"></i> 5-year warranty included</li>
              </ul>
            </div>
          </div>
        </div>
        <div class="tab-pane fade" id="profile" role="tabpanel">
          <table class="table product-table">
            <thead><tr><th>Dimension</th><th>Width</th><th>Depth</th><th>Height</th></tr></thead>
            <tbody>
              <tr><td>Small</td><td>180cm</td><td>90cm</td><td>85cm</td></tr>
              <tr><td>Medium</td><td>220cm</td><td>95cm</td><td>85cm</td></tr>
              <tr><td>Large</td><td>260cm</td><td>100cm</td><td>85cm</td></tr>
            </tbody>
          </table>
        </div>
        <div class="tab-pane fade review" id="contact" role="tabpanel">
          <div class="row product-review gy-lg-0 gy-4">
            <div class="col-lg-5 col-md-12">
              <div class="reviewr-wrap">
                <div class="review-list">
                  {
                    reviews.map((review) => (
                      <div class="review-item">
                        <div class="review-thumb">
                          <img src={review.image} alt={review.author} loading="lazy" />
                        </div>
                        <div class="content">
                          <div class="content-top">
                            <h4 class="name">
                              {review.author} <span>{review.date}</span>
                            </h4>
                            <ul class="review">
                              {[1, 2, 3, 4, 5].map(() => (
                                <li>
                                  <i class="fa-sharp fa-solid fa-star" />
                                </li>
                              ))}
                            </ul>
                          </div>
                          <p>{review.text}</p>
                        </div>
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>
            <div class="col-lg-7 col-md-12">
              <div class="review-form-wrap">
                <h4 class="title">Review this product</h4>
                <span class="publish">Your email address will not be published. Required fields are marked *</span>
                <div class="review-box">
                  <span>Your ratings:</span>
                  <ul class="review">
                    {
                      [1, 2, 3, 4, 5].map(() => (
                        <li>
                          <i class="fa-sharp fa-solid fa-star" />
                        </li>
                      ))
                    }
                  </ul>
                </div>
                <div class="blog-contact-form form-2 review-form">
                  <div class="request-form">
                    <form action="/api/mail" method="post" class="form-horizontal">
                      <div class="form-group row">
                        <div class="col-md-12">
                          <div class="form-item">
                            <input type="text" name="fullname" class="form-control" placeholder="Your Name" />
                          </div>
                        </div>
                        <div class="col-md-12">
                          <div class="form-item">
                            <input type="email" name="email" class="form-control" placeholder="Your Email" />
                          </div>
                        </div>
                      </div>
                      <div class="form-group row">
                        <div class="col-md-12">
                          <div class="form-item message-item">
                            <textarea
                              name="message"
                              cols="30"
                              rows="5"
                              class="form-control address"
                              placeholder="Comment"></textarea>
                          </div>
                        </div>
                      </div>
                      <div class="submit-btn">
                        <button class="tl-primary-btn" type="submit"
                          >Submit <span class="icon"><i class="fa-regular fa-arrow-right"></i></span></button
                        >
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="shop-inner pb-150">
    <div class="container container-2">
      <div class="section-heading">
        <h2 class="section-title title-2">Related Products</h2>
      </div>
      <div class="row">
        {
          relatedProducts.map((product) => (
            <div class="col-lg-3 col-md-6">
              <div class="shop-item">
                <div class="shop-thumb">
                  <div class="overlay" />
                  <img src={product.image} alt={product.name} loading="lazy" />
                  <ul class="shop-list">
                    <li>
                      <a href="#">
                        <i class="fa-regular fa-cart-shopping" />
                      </a>
                    </li>
                    <li>
                      <a href="#">
                        <i class="fa-light fa-heart" />
                      </a>
                    </li>
                    <li>
                      <a href="#">
                        <i class="fa-light fa-eye" />
                      </a>
                    </li>
                  </ul>
                </div>
                <div class="shop-content">
                  <h3 class="title">
                    <a href="/shop-details">{product.name}</a>
                  </h3>
                  <div class="review-wrap">
                    <ul class="review">
                      {[1, 2, 3, 4, 5].map(() => (
                        <li>
                          <i class="fa-solid fa-star" />
                        </li>
                      ))}
                    </ul>
                  </div>
                  <span class="price">{product.price}</span>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

