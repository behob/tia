---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import TeamMemberCard from '../components/cards/TeamMemberCard.astro';
import { teamMembers } from '../data/team';
import { site } from '../data/site';

const teamSocials = Object.fromEntries(
  site.socials
    .filter((s) => ['facebook', 'instagram', 'behance', 'linkedin'].includes(s.platform))
    .map((s) => [s.platform, s.href]),
);
---

<Layout
  title="Our Team - TIA Interior"
  description="Meet the talented team behind TIA Interior's award-winning luxury design projects."
>
  <PageHeader title="Our Team" currentPage="Team" />

  <section class="team-section pt-130 pb-130">
    <div class="container container-2">
      <div class="row gy-5" data-masonry='{"percentPosition": true }'>
        {
          teamMembers.map((member, i) => (
            <div class="col-lg-4 col-md-6">
              <TeamMemberCard
                image={member.image}
                name={member.name}
                role={member.role}
                variant="grid"
                social={teamSocials}
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
