                      <span>Watch a Video <br />About Us</span>
                      <div class="play-btn-wrap">
                        <img src="/assets/img/images/slider-play-img.png" alt="img" loading="lazy" />
                        <div class="play-btn">
                          <a
                            class="video-popup venobox"
                            data-autoplay="true"
