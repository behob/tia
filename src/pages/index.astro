  <script>
    // Lazy-load Three.js and Panolens only when 360 panorama container enters viewport
    const panoContainer = document.querySelector('.antra-panoroma-img');
    if (panoContainer) {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              obs.disconnect();
              const loadScript = (src: string) => {
                return new Promise<void>((resolve, reject) => {
                  const s = document.createElement('script');
                  s.src = src;
                  s.onload = () => resolve();
                  s.onerror = reject;
                  document.body.appendChild(s);
                });
              };

              loadScript('/assets/js/vendor/three.min.js')
                .then(() => loadScript('/assets/js/vendor/panolens.min.js'))
                .then(() => {
                  const antraData = panoContainer.getAttribute('data-img') || '/assets/img/bg-img/virtual-tours.webp';
                  // @ts-ignore
                  if (window.PANOLENS) {
                    // @ts-ignore
                    const panorama = new window.PANOLENS.ImagePanorama(antraData);
                    // @ts-ignore
                    const panoViewer = new window.PANOLENS.Viewer({ container: panoContainer });
                    panoViewer.add(panorama);
                  }
                })
                .catch((err) => console.error('Failed to load virtual tour viewer:', err));
            }
          });
        },
        { rootMargin: '200px' }
      );
      observer.observe(panoContainer);
    }
  </script>
