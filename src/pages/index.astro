            </div>
            <span class="number">04</span>
          </div>
        </div>
      </div>
      <div class="process-text">
        <h5 class="bottom-text">We’ve been working hard to impress you. <a href="/contact">Start your’s today</a></h5>
      </div>
    </div>
  </section>
  <!-- ./ process-section -->

  <section class="project-section pt-130 tl-bg-color fade-wrapper">
    <div class="bg-shape" data-background="/assets/img/shapes/project-shape-1.webp"></div>
    <div class="project-text"><span>Interior</span></div>
    <div class="container container-2">
      <div class="row section-heading-wrap fade-top">
        <div class="shape"><img src="/assets/img/shapes/section-heading.webp" alt="shape" loading="lazy" /></div>
        <div class="col-lg-4 col-md-12">
          <div class="section-heading mb-0">
            <h4
              class="sub-heading"
              data-text-animation="fade-in-right"
              data-split="char"
              data-duration="0.9"
              data-stagger="0.03"
