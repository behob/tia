---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import NewsletterSection from '../components/sections/NewsletterSection.astro';
import { customFurnitureServices } from '../data/services';
---

<Layout
  title="Custom Furniture - TIA Interior"
  description="Custom furniture design and manufacturing for luxury interior spaces."
>
  <PageHeader title="Services" currentPage="Custom Furniture" />

  <section class="service-inner pt-130 pb-130">
    <div class="container container-2">
      <div class="row gy-5">
        {
          customFurnitureServices.map((s) => (
            <div class="col-lg-4 col-md-6">
              <div class="service-item-3 antra-hover-view">
                <div class="service-thumb">
                  <a href="/service-details">
                    <img src={s.image} alt={s.title} loading="lazy" />
                  </a>
                  <span class="number">{s.num}</span>
                </div>
                <div class="service-content">
                  <h5 class="title">
                    <a href="/service-details">{s.title}</a>
                  </h5>
                  <p>{s.desc}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <NewsletterSection extraClass="pt-130" />
</Layout>
