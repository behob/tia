---
import OptimizedImage from '../components/ui/OptimizedImage.astro';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import NewsletterSection from '../components/sections/NewsletterSection.astro';
import { commercialProjects } from '../data/portfolio';
---

<Layout
  title="Commercial Projects - TIA Interior"
  description="Explore our commercial interior design projects in Dubai."
>
  <PageHeader title="Our Projects" currentPage="Commercial Projects" />

  <section class="project-section-inner pt-130 pb-130">
    <div class="container">
      <div class="row gy-5">
        {
          commercialProjects.map((p) => (
            <div class="col-lg-4 col-md-6">
              <div class="project-item-3">
                <div class="project-img">
                  <OptimizedImage src={p.image} alt={p.title} loading="lazy" />
                </div>
                <div class="project-content">
                  <ul>
                    <li>
                      <a href="/portfolio-details">{p.category}</a>
                    </li>
                    <li>
                      <a href="/portfolio-details">Single Home</a>
                    </li>
                  </ul>
                  <h3 class="title">
                    <a href="/portfolio-details">{p.title}</a>
                  </h3>
                  <span>
                    Dubai, UAE
                    <br />
                    2025
                  </span>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <NewsletterSection />
</Layout>
