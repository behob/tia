---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Antra - Architecture & Interior Design HTML Template" description="">
<section class="page-header">
            <div class="bg-img" data-background="/assets/img/bg-img/page-header-bg.png"></div>
            <div class="overlay"></div>
            <div class="container">
                <div class="page-header-content">
                    <h1 class="title">gallery</h1>
                    <h4 class="sub-title"><a class='home' href="/">Home </a><span class="icon">-</span><a class='inner-page' href="/gallary-2"> Bathroom Bliss</a></h4>
                </div>
            </div>
        </section>
        <!-- ./ page-header -->

        <section class="gallery-inner bg-white pt-130 pb-130">
            <div class="container container-2">
                <div class="row gallary-inner-top">
                    <div class="col-lg-6 col-md-6">
                        <div class="gallary-inner-item-2">
                            <a href="/assets/img/project/gallary-img-6.png" class="venobox" data-gall="gallary1"><img src="/assets/img/project/gallary-img-6.png" alt="img"></a>
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6">
                        <div class="gallary-inner-items">
                            <div class="gallary-inner-item-2">
                                <a href="/assets/img/project/gallary-img-7.png" class="venobox" data-gall="gallary1"><img src="/assets/img/project/gallary-img-7.png" alt="img"></a>
                            </div>
                            <div class="gallary-inner-item-2">
                                <a href="/assets/img/project/gallary-img-8.png" class="venobox" data-gall="gallary1"><img src="/assets/img/project/gallary-img-8.png" alt="img"></a>
                            </div>
                            <div class="gallary-inner-item-2">
                                <a href="/assets/img/project/gallary-img-9.png" class="venobox" data-gall="gallary1"><img src="/assets/img/project/gallary-img-9.png" alt="img"></a>
                            </div>
                            <div class="gallary-inner-item-2">
                                <a href="/assets/img/project/gallary-img-10.png" class="venobox" data-gall="gallary1"><img src="/assets/img/project/gallary-img-10.png" alt="img"></a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-6 col-md-6">
                        <div class="gallary-inner-items">
                            <div class="gallary-inner-item-2">
                                <a href="/assets/img/project/gallary-img-11.png" class="venobox" data-gall="gallary1"><img src="/assets/img/project/gallary-img-11.png" alt="img"></a>
                            </div>
                            <div class="gallary-inner-item-2">
                                <a href="/assets/img/project/gallary-img-12.png" class="venobox" data-gall="gallary1"><img src="/assets/img/project/gallary-img-12.png" alt="img"></a>
                            </div>
                            <div class="gallary-inner-item-2">
                                <a href="/assets/img/project/gallary-img-13.png" class="venobox" data-gall="gallary1"><img src="/assets/img/project/gallary-img-13.png" alt="img"></a>
                            </div>
                            <div class="gallary-inner-item-2">
                                <a href="/assets/img/project/gallary-img-14.png" class="venobox" data-gall="gallary1"><img src="/assets/img/project/gallary-img-14.png" alt="img"></a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6">
                        <div class="gallary-inner-item-2">
                            <a href="/assets/img/project/gallary-img-15.png" class="venobox" data-gall="gallary1"><img src="/assets/img/project/gallary-img-15.png" alt="img"></a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="newsletter-section bg-white pb-130 overflow-hidden">
            <div class="bg-shape"><img src="/assets/img/shapes/newsletter-shape.png" alt="shape"></div>
            <div class="container">
                <div class="newsletter-wrap">
                    <div class="section-heading text-center">
                        <h4 class="sub-heading" data-text-animation="fade-in-right" data-split="char" data-duration="0.9" data-stagger="0.03">Subscribe to the newsletter</h4>
                        <h2 class="section-title">Join <span>our newsletter <br> stay</span> up to date</h2>
                        <p>Join our newsletter. Learn something new, gain access to exclusive content, <br> and stay informed with the latest updates in the industry.</p>
                    </div>
                    <div class="newsletter-form">
                        <input type="text" id="email" name="email" class="form-control" placeholder="Email address..">
                        <button type="submit"><i class="fa-regular fa-arrow-right-long"></i></button>
                        
                    </div>
                </div>
            </div>
        </section>
        <!-- ./ newsletter-section -->
</Layout>
