---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="TIA Interior - Architecture & Interior Design"
  description="TIA Interior - Renovation and makeover services in Dubai. Transform your existing space into something extraordinary."
>
  <section class="hero-section-8 overflow-hidden tl-bg-color">
    <div class="bg-shape" data-background="/assets/img/shapes/hero-shape-2.webp"></div>
    <div class="container">
      <div class="hero-wrap-8 pt-130">
        <div class="hero-content-8 white-content">
          <div class="section-heading mb-0 slide-anim" data-delay="2.3" data-offset="100" data-direction="left">
            <h4
              class="sub-heading"
              data-text-animation="fade-in-right"
              data-split="char"
              data-duration="0.9"
              data-stagger="0.03"
            >
              Trusted Design Partner
            </h4>
            <h2 class="section-title cursor-effect">Find Your Inspired <br /><span>Interior Design</span></h2>
            <div class="hero-btn mt-50">
              <a href="/service" class="tl-primary-btn"
                >Get our services <span class="icon"><i class="fa-regular fa-arrow-right"></i></span></a
              >
            </div>
          </div>
          <div class="hero-content-left slide-anim" data-delay="2.3" data-offset="100" data-direction="right">
            <div class="hero-thumb">
              <img src="/assets/img/images/hero-img-3.webp" alt="thumb" loading="lazy" />
            </div>
            <p>
              Whether it’s your home, office, or a commercial project, we are always dedicated to bringing <br /> your vision
              to life.
            </p>
          </div>
        </div>
        <div class="hero-bottom-img slide-anim" data-delay="2.3" data-offset="100" data-direction="bottom">
          <img src="/assets/img/images/hero-img-4.webp" alt="img" loading="lazy" />
        </div>
      </div>
    </div>
  </section>
  <!-- ./ hero-section -->

  <section class="feature-section pt-100 feature-8 fade-wrapper tl-bg-color">
    <div class="feature-text"><span>tia</span></div>
    <div class="feature-element scroll-area">
      <img class="scroll-img" src="/assets/img/images/counter-img-1.webp" alt="counter" loading="lazy" />
    </div>
    <div class="container container-2">
      <div class="row section-heading-wrap fade-top feature-top">
        <div class="shape"><img src="/assets/img/shapes/section-heading.webp" alt="shape" loading="lazy" /></div>
        <div class="col-lg-4 col-md-12">
          <div class="section-heading mb-0">
            <h4
              class="sub-heading"
              data-text-animation="fade-in-right"
              data-split="char"
              data-duration="0.9"
              data-stagger="0.03"
            >
              WHO We Are
            </h4>
          </div>
        </div>
        <div class="col-lg-8 col-md-12">
          <div class="section-heading section-heading-2 mb-0">
            <h2 class="section-title cursor-effect title-2">
              Explore our <span>comprehensive <br /> interior design</span> services
            </h2>
            <p class="mb-0">
              We specialize in transforming visions into reality. Explore our portfolio of innovative architectural <br
              /> and interior design projects <br /> crafted with precision.
            </p>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-lg-6">
          <div class="feature-item-imgs slide-anim" data-delay="0.3" data-offset="100" data-direction="left">
            <div class="feature-img">
              <img src="/assets/img/service/feature-img-1.webp" alt="feature" loading="lazy" />
              <div class="img-content">
                <p>
                  Tailored design services for private homes, including room makeovers and complete home
                  transformations.
                </p>
              </div>
            </div>
          </div>
        </div>
        <div class="col-lg-6">
          <div
            class="feature-item-list feature-item-list-1 slide-anim"
            data-delay="0.3"
            data-offset="100"
            data-direction="right"
          >
            <div
              class="feature-item"
              data-img="assets/img/service/feature-img-1.webp"
              data-text="Tailored design services for private homes, including room makeovers and complete home transformations."
            >
              <span class="number">01</span>
              <h3 class="title"><a href="/service-details">Residential Interior Design</a></h3>
              <a href="/service-details" class="arrow"><i class="fa-regular fa-arrow-right"></i></a>
            </div>
            <div
              class="feature-item"
              data-img="assets/img/service/feature-img-2.webp"
              data-text="Extending design services to outdoor spaces such as gardens, patios, and decks."
            >
              <span class="number">02</span>
              <h3 class="title"><a href="/service-details">Commercial Interior Design</a></h3>
              <a href="/service-details" class="arrow"><i class="fa-regular fa-arrow-right"></i></a>
            </div>
            <div
              class="feature-item"
              data-img="assets/img/service/feature-img-3.webp"
              data-text="Providing professional advice on concepts, color schemes & material selection."
            >
              <span class="number">03</span>
              <h3 class="title"><a href="/service-details">Interior Design Consultation</a></h3>
              <a href="/service-details" class="arrow"><i class="fa-regular fa-arrow-right"></i></a>
            </div>
            <div
              class="feature-item"
              data-img="assets/img/service/feature-img-4.webp"
              data-text="Designing functional and attractive interiors for businesses, including offices, retail spaces, and hospitality venues."
            >
              <span class="number">04</span>
              <h3 class="title"><a href="/service-details">Outdoor & Landscape Design</a></h3>
              <a href="/service-details" class="arrow"><i class="fa-regular fa-arrow-right"></i></a>
            </div>
            <div
              class="feature-item"
              data-img="assets/img/service/feature-img-5.webp"
              data-text="Overhauling existing spaces to modernize and improve functionality and aesthetics."
            >
              <span class="number">05</span>
              <h3 class="title"><a href="/service-details">Renovation and Remodeling</a></h3>
              <a href="/service-details" class="arrow"><i class="fa-regular fa-arrow-right"></i></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- ./ feature-section -->

  <section class="about-section-8 pt-130 pb-130 fade-wrapper">
    <div class="bg-blur-shape"></div>
    <div class="about-bg" data-background="/assets/img/bg-img/about-bg-2.webp"></div>
    <div class="container container-2">
      <div class="section-heading white-content fade-top">
        <h4
