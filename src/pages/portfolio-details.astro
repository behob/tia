---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { portfolioDetail } from '../data/portfolio';
---

<Layout title="Project Details - TIA Interior" description="Detailed view of our latest interior design project.">
  <PageHeader title="Project Details" currentPage="Project Details" />

  <section class="portfolio-details pt-130 pb-130">
    <div class="container container-2">
      <div class="project-details-wrap">
        <h1 class="details-title">{portfolioDetail.title}</h1>
        <div class="project-details-meta">
          <div class="details-meta">
            <span>Architect :</span>
            <h5>{portfolioDetail.architect}</h5>
          </div>
          <div class="details-meta">
            <span>Project Type:</span>
            <h5>{portfolioDetail.projectType}</h5>
          </div>
          <div class="details-meta">
            <span>Client:</span>
            <h5>{portfolioDetail.client}</h5>
          </div>
          <div class="details-meta">
            <span>Terms:</span>
            <h5>{portfolioDetail.terms}</h5>
          </div>
          <div class="details-meta">
            <span>Strategy :</span>
            <h5>{portfolioDetail.strategy}</h5>
          </div>
          <div class="details-meta">
            <span>Date :</span>
            <h5>{portfolioDetail.date}</h5>
          </div>
        </div>
        <div class="project-details-img">
          <img src={portfolioDetail.heroImage} alt="project details" loading="lazy" />
        </div>
        <h2 class="details-title-2">Design in Details</h2>
        <p>{portfolioDetail.description}</p>
        <div class="project-details-list">
          <ul>
            {
              portfolioDetail.features.slice(0, 3).map((f) => (
                <li>
                  <>
                    <i class="fa-sharp fa-solid fa-circle-check" />
                    <strong>{f.title}:</strong>
                  </>{' '}
                  {f.desc}
                </li>
              ))
            }
          </ul>
          <ul>
            {
              portfolioDetail.features.slice(3).map((f) => (
                <li>
                  <>
                    <i class="fa-sharp fa-solid fa-circle-check" />
                    <strong>{f.title}:</strong>
                  </>{' '}
                  {f.desc}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="project-details-items">
          {
            portfolioDetail.roomSizes.map((room) => (
              <div class="project-details-item text-center">
                <h3 class="title">({room.size})</h3>
                <span>{room.label}</span>
              </div>
            ))
          }
        </div>
        <h3 class="details-title-2">Incredible Result</h3>
        <p>{portfolioDetail.resultDescription}</p>
      </div>
    </div>
  </section>
</Layout>
