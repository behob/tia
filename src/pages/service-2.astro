---
import OptimizedImage from '../components/ui/OptimizedImage.astro';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import NewsletterSection from '../components/sections/NewsletterSection.astro';
import { fitOutServices } from '../data/services';
---

<Layout
  title="Fit-Out & Execution - TIA Interior"
  description="Our fit-out and execution services bring your interior design vision to life with precision."
>
  <PageHeader title="Services" currentPage="Fit-Out & Execution" />

  <section class="service-inner pt-130 pb-130">
    <div class="container container-2">
      <div class="row service-inner-item-wrap gy-5" data-masonry='{"percentPosition": true }'>
        {
          fitOutServices.map((s) => (
            <div class="col-lg-4 col-md-6">
              <div class={`service-item-2 antra-hover-view${s.big ? ' big' : ''}`}>
                <div class="service-thumb">
                  <a href="/service-details">
                    <OptimizedImage src={s.image} alt={s.title} loading="lazy" />
                  </a>
                  <span class="number">{s.num}</span>
                </div>
                <div class="service-content">
                  <h5 class="title">
                    <a href="/service-details">{s.title}</a>
                  </h5>
                  <p>{s.desc}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <NewsletterSection extraClass="pt-130" />
</Layout>
