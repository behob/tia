      </div>
      <div class="row about-item-wrap gy-lg-0 gy-4 fade-wrapper">
        <div class="col-lg-4 col-md-6">
          <div class="about-item-4 antra-hover-view fade-top">
            <a href="/portfolio"><OptimizedImage src="/assets/img/images/about-item-img-1.webp" alt="about" loading="lazy" /></a>
          </div>
        </div>
        <div class="col-lg-4 col-md-6">
          <div class="about-item-4 antra-hover-view fade-top">
            <a href="/portfolio"><OptimizedImage src="/assets/img/images/about-item-img-2.webp" alt="about" loading="lazy" /></a>
          </div>
        </div>
        <div class="col-lg-4 col-md-6 antra-hover-view fade-top">
          <div class="about-item-4">
            <a href="/portfolio"><OptimizedImage src="/assets/img/images/about-item-img-3.webp" alt="about" loading="lazy" /></a>
