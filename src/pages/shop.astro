---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
---

<Layout title="Shop - TIA Interior" description="Browse our curated collection of furniture and decor.">
  <PageHeader title="Gallery" currentPage="Shop" />

  <section class="shop-grid pt-100 pb-100">
    <div class="container container-2">
      <div class="row">
        <div class="col-lg-3 col-md-12">
          <div class="shop-sidebar">
            <h3 class="sidebar-header">Search</h3>
            <form action="#" class="search-form">
              <input type="text" class="form-control" placeholder="Search..." />
              <button class="search-btn" type="button"><i class="fa-regular fa-magnifying-glass"></i></button>
            </form>
          </div>
          <div class="shop-sidebar">
            <h3 class="sidebar-header">Categories</h3>
            <ul class="sidebar-list">
              {
                [
                  'Bench (4)',
                  'Bookcase (4)',
                  'Dining Table (1)',
                  'Dressing Table (12)',
                  'Clothing & Apparel (2)',
                  'Furniture (3)',
                  'Office Chair (3)',
                  'Uncategorized (5)',
                ].map((cat, i) => (
                  <li>
                    <input type="checkbox" id={`cat-${i}`} name={`cat-${i}`} value={cat} />
                    <label for={`cat-${i}`}> {cat}</label>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="shop-sidebar sticky-widget">
            <h3 class="sidebar-header">Brands</h3>
            <div class="sidebar-items">
              {
                [
                  { img: '/assets/img/shop/sidebar-img-1.png', title: 'Durable Timber Structure' },
                  { img: '/assets/img/shop/sidebar-img-2.png', title: 'Arabesque Design Vase' },
                  { img: '/assets/img/shop/sidebar-img-3.png', title: 'Coffee Table Ocean Blue' },
                  { img: '/assets/img/shop/sidebar-img-4.png', title: 'Framed Canvas Painting' },
                ].map((item) => (
                  <div class="sidebar-item">
                    <div class="item-img">
                      <img src={item.img} alt={item.title} loading="lazy" />
                    </div>
                    <div class="content">
                      <h4 class="title">{item.title}</h4>
                      <ul class="review">
                        {[1, 2, 3, 4, 5].map(() => (
                          <li>
                            <i class="fa-solid fa-star" />
                          </li>
                        ))}
                      </ul>
                      <span class="price">$55.00</span>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
        <div class="col-lg-9 col-md-12">
          <div class="shop-grid-left">
            <div class="top-grid-content">
              <span>Showing 1-12 of 88 results</span>
            </div>
            <div class="tab-content" id="nav-tabContent">
              <div class="tab-pane fade show active" id="nav-home" role="tabpanel">
                <div class="row gy-4">
                  {
                    [1, 2, 3, 4, 5, 6, 7, 8, 9].map((i) => (
                      <div class="col-xl-4 col-lg-6 col-md-6">
                        <div class="shop-item">
                          <div class="shop-thumb">
                            <div class="overlay" />
                            <img src={`/assets/img/shop/shop-${i}.png`} alt="shop" loading="lazy" />
                            <ul class="shop-list">
                              <li>
                                <a href="#">
                                  <i class="fa-regular fa-cart-shopping" />
                                </a>
                              </li>
                              <li>
                                <a href="#">
                                  <i class="fa-light fa-heart" />
                                </a>
                              </li>
                              <li>
                                <a href="#">
                                  <i class="fa-light fa-eye" />
                                </a>
                              </li>
                            </ul>
                          </div>
                          <div class="shop-content">
                            <h3 class="title">
                              <a href="/shop-details">Modern Caramel Fabric Sofa</a>
                            </h3>
                            <div class="review-wrap">
                              <ul class="review">
                                {[1, 2, 3, 4, 5].map(() => (
                                  <li>
                                    <i class="fa-solid fa-star" />
                                  </li>
                                ))}
                              </ul>
                            </div>
                            <span class="price">$157.00</span>
                          </div>
                        </div>
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
          <ul class="pagination-wrap mt-50 justify-content-center">
            <li><a href="#">1</a></li>
            <li><a href="#" class="active">2</a></li>
            <li><a href="#">3</a></li>
            <li><a href="#"><i class="fa-regular fa-arrow-right"></i></a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>
