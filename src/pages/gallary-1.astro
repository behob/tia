---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import NewsletterSection from '../components/sections/NewsletterSection.astro';

const galleryItems = [
  { image: '/assets/img/project/gallary-img-1.png', title: 'Bathroom Bliss' },
  { image: '/assets/img/project/gallary-img-2.png', title: 'Living Room Stories' },
  { image: '/assets/img/project/gallary-img-3.png', title: 'Office Room' },
  { image: '/assets/img/project/gallary-img-4.png', title: 'Elegant Dining Spaces' },
  { image: '/assets/img/project/gallary-img-5.png', title: 'Serene Bedrooms' },
];
---

<Layout title="Gallery - TIA Interior" description="Browse our gallery of stunning interior design projects.">
  <PageHeader title="Gallery" currentPage="Gallery" />

  <section class="gallery-inner pt-130 pb-130">
    <div class="container container-2">
      <div class="row section-heading-wrap ml-0 mw-100">
        <div class="shape"><img src="/assets/img/shapes/section-heading.png" alt="shape" /></div>
        <div class="col-lg-4 col-md-12">
          <div class="section-heading mb-0">
            <h4 class="sub-heading" data-text-animation="fade-in-right" data-split="char" data-duration="0.9" data-stagger="0.03">our gallery</h4>
          </div>
        </div>
        <div class="col-lg-8 col-md-12">
          <div class="section-heading section-heading-2 mb-0 pl-0">
            <h2 class="section-title title-2">Gallery <span>of inspiring <br /> interior</span> designs</h2>
          </div>
        </div>
      </div>
    </div>
    <div class="container">
      <div class="gallary-item-wrap-inner">
        {galleryItems.map((item) => (
          <div class="gallary-item-inner">
            <a href={item.image} class="venobox" data-gall="gallary1"><img src={item.image} alt={item.title} /></a>
            <h4 class="title">{item.title}</h4>
          </div>
        ))}
      </div>
    </div>
  </section>

  <NewsletterSection extraClass="pt-130" />
</Layout>
