        </div>
        <div class="col-lg-7">
          <div class="skill-img slide-anim" data-delay="0.3" data-offset="100" data-direction="right">
            <OptimizedImage src="/assets/img/images/skill-img-1.webp" alt="skill" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>
