  <section class="skill-section pt-130 pb-130 overflow-hidden fade-wrapper">
    <div class="skill-text">tia</div>
    <div class="shape-1"><OptimizedImage src="/assets/img/shapes/skill-shape-1.webp" alt="shape" loading="lazy" /></div>
    <div class="container container-2">
      <div class="row section-heading-wrap pl-0 mw-100 fade-top">
