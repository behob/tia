                    <div class="service-thumb">
                      <OptimizedImage src="/assets/img/service/service-img-1.webp" alt="service" loading="lazy" />
                      <span class="number">01</span>
                    </div>
                    <div class="service-content">
                      <h5 class="title"><a href="/service-details">Residential Interior Design</a></h5>
                      <p>
                        Tailored design services for private homes, including room makeovers and complete home
                        transformations.
                      </p>
                    </div>
                  </div>
                </div>
                <div class="swiper-slide">
                  <div class="service-item-3">
                    <div class="service-thumb">
                      <OptimizedImage src="/assets/img/service/service-img-3.webp" alt="service" loading="lazy" />
                      <span class="number">02</span>
                    </div>
                    <div class="service-content">
                      <h5 class="title"><a href="/service-details">Residential Interior Design</a></h5>
                      <p>
                        Tailored design services for private homes, including room makeovers and complete home
                        transformations.
                      </p>
