---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';

const posts = [
  { image: '/assets/img/blog/post-inner-1.png', title: 'Transform Your Home With the Modern Interior Design Tips', excerpt: 'Modern interior design is all about creating a sleek, functional, and aesthetically pleasing space that reflects contemporary living.', date: 'Dec 25, 2025', category: 'Exteriors', featured: true },
  { image: '/assets/img/blog/post-6.png', title: 'Maximize Your Minimalist Space With Smart Solutions', excerpt: 'Modest, recently established interior design company that seeks to address a variety of topics, including...', date: 'Dec 25, 2025', category: 'Exteriors' },
  { image: '/assets/img/blog/post-5.png', title: 'Perfectly Redefining Interior Spaces for Modern Lifestyles', excerpt: 'Modest, recently established interior design company that seeks to address a variety of topics, including...', date: 'Dec 25, 2025', category: 'Exteriors' },
  { image: '/assets/img/blog/post-4.png', title: 'Modern Materials That Elevate Your Home\'s Functionality', excerpt: 'Modest, recently established interior design company that seeks to address a variety of topics, including...', date: 'Dec 25, 2025', category: 'Exteriors' },
  { image: '/assets/img/blog/post-3.png', title: 'Modern Rooms Creating Elegant Spaces for Relaxation', excerpt: 'Modest, recently established interior design company that seeks to address a variety of topics, including...', date: 'Dec 25, 2025', category: 'Exteriors' },
  { image: '/assets/img/blog/post-2.png', title: 'Luxury Living Redefined Elegant for the Modern Home', excerpt: 'Modest, recently established interior design company that seeks to address a variety of topics, including...', date: 'Dec 25, 2025', category: 'Exteriors' },
];

const sidebarPosts = [
  { image: '/assets/img/blog/sidebar-post-1.png', title: 'Maximize Your Minimalist Space With Smart Solutions', date: 'Sep 10, 2025' },
  { image: '/assets/img/blog/sidebar-post-2.png', title: 'Exploring Trends and Techniques in Interior Design', date: 'Sep 10, 2025' },
  { image: '/assets/img/blog/sidebar-post-3.png', title: 'The Aesthetics Agenda: Redefining Interior Elegance', date: 'Sep 10, 2025' },
  { image: '/assets/img/blog/sidebar-post-4.png', title: 'Transforming Spaces into Dream Dwellings', date: 'Sep 10, 2025' },
];

const categories = ['Accessories', 'Electrical & Lighting', 'Home Appliance', 'Power Tools', 'Uncategorized', 'Ware Accessories'];
const tags = ['Architecture', 'Construction', 'Furniture', 'Design', 'Interior', 'Kitchen', 'Living Room', 'Building', 'Planning'];
---

<Layout title="Blog List - TIA Interior" description="Read the latest interior design articles and insights.">
  <PageHeader title="Blog" currentPage="Blog List" />

  <section class="blog-section pt-130 pb-130 fade-wrapper">
    <div class="container container-2">
      <div class="row">
        <div class="col-lg-8 col-md-6">
          {posts.map((post, i) => (
            i === 0 ? (
              <div class="post-card inner-post">
                <div class="post-thumb">
                  <img src={post.image} alt={post.title} />
                </div>
                <div class="post-content">
                  <ul class="post-meta">
                    <li class="category">{post.category.toLowerCase()}</li>
                    <li>{post.date}</li>
                    <li>By <span>Admin</span></li>
                  </ul>
                  <h3 class="title"><a href="/blog-details">{post.title}</a></h3>
                  <p>{post.excerpt}</p>
                  <a href="/blog-details" class="read-more">Read More</a>
                </div>
              </div>
            ) : (
              <div class={`post-card-wrap${i === 1 ? ' post-card-wrap-inner' : ''}`} style={i > 1 ? 'display: none;' : ''}>
                <div class="post-card">
                  <div class="post-thumb">
                    <img src={post.image} alt={post.title} />
                  </div>
                  <div class="post-content">
                    <ul class="post-meta">
                      <li class="category">{post.category.toLowerCase()}</li>
                      <li>{post.date}</li>
                      <li>By <span>Admin</span></li>
                    </ul>
                    <h3 class="title"><a href="/blog-details">{post.title}</a></h3>
                    <p>{post.excerpt}</p>
                    <a href="/blog-details" class="read-more">Read More</a>
                  </div>
                </div>
              </div>
            )
          ))}
          <ul class="pagination-wrap mt-100 justify-content-center">
            <li><a href="#">1</a></li>
            <li><a href="#" class="active">2</a></li>
            <li><a href="#">3</a></li>
            <li><a href="#"><i class="fa-regular fa-arrow-right"></i></a></li>
          </ul>
        </div>
        <div class="col-lg-4">
          <div class="sidebar-widget">
            <h3 class="widget-title">Search</h3>
            <div class="search-box">
              <form action="#" class="search-form">
                <input type="text" class="form-control" placeholder="Search" />
                <button class="search-btn" type="button"><i class="fa-regular fa-magnifying-glass"></i></button>
              </form>
            </div>
          </div>
          <div class="sidebar-widget">
            <h3 class="widget-title">Categories</h3>
            <ul class="category-list">
              {categories.map((cat) => (
                <li><a href="#">{cat}</a></li>
              ))}
            </ul>
          </div>
          <div class="sidebar-widget">
            <h3 class="widget-title">Recent Post</h3>
            {sidebarPosts.map((post) => (
              <div class="sidebar-post">
                <img src={post.image} alt={post.title} />
                <div class="post-content">
                  <ul class="post-meta">
                    <li>{post.date}</li>
                  </ul>
                  <h3 class="title"><a href="#">{post.title}</a></h3>
                </div>
              </div>
            ))}
          </div>
          <div class="sidebar-widget sticky-widget">
            <h3 class="widget-title">Tags</h3>
            <ul class="tags">
              {tags.map((tag) => (
                <li><a href="#">{tag}</a></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
