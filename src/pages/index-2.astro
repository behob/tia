      <div class="heading-space mb-80">
        <div class="section-heading mb-0 slide-anim" data-delay="0.3" data-offset="100" data-direction="left">
          <h4
            class="sub-heading"
            data-text-animation="fade-in-right"
            data-split="char"
            data-duration="0.9"
            data-stagger="0.03"
