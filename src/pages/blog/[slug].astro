---
import BlogSingleLayout from '../../layouts/BlogSingleLayout.astro';
import { getBlogPosts, type BlogPost } from '../../data/blog';

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.flatMap((post) => [
    { params: { slug: post.slug }, props: { post, redirect: false } },
    ...post.aliases.map((slug) => ({ params: { slug }, props: { post, redirect: true } })),
  ]);
}
interface Props {
  post: BlogPost;
  redirect: boolean;
}
const { post, redirect } = Astro.props;
if (redirect) return Astro.redirect(post.href, 301);
---

<BlogSingleLayout post={post} />
