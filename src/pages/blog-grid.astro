---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import BlogPostCard from '../components/cards/BlogPostCard.astro';
import NewsletterSection from '../components/sections/NewsletterSection.astro';

const posts = [
  { image: '/assets/img/blog/post-1.jpg', title: 'Four Ways for Creating Extra Space in Small Homes', excerpt: 'Modest, recently established interior design company that seeks to address a variety of topics, including...', date: 'Dec 25, 2025', category: 'Exteriors' },
  { image: '/assets/img/blog/post-2.png', title: 'Transform Your Home With the Modern Interior Design Tips', excerpt: 'Modest, recently established interior design company that seeks to address a variety of topics, including...', date: 'Dec 25, 2025', category: 'Exteriors' },
  { image: '/assets/img/blog/post-3.png', title: 'The Art of Minimalist Interior Design for Modern Living', excerpt: 'Modest, recently established interior design company that seeks to address a variety of topics, including...', date: 'Dec 25, 2025', category: 'Exteriors' },
];
---

<Layout title="Blog - TIA Interior" description="Read the latest interior design tips, trends, and insights from TIA Interior.">
  <PageHeader title="Blog" currentPage="Blog" />

  <section class="blog-section pt-150 pb-150 fade-wrapper">
    <div class="container container-2">
      <div class="row gy-5 fade-wrapper">
        {posts.map((post) => (
          <div class="col-lg-4 col-md-6 fade-top">
            <BlogPostCard {...post} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <NewsletterSection />
</Layout>
